# Record the CMake link interfaces of FLAC, Opus and the optional IAMF bridge for Cargo.
function(mr_adm_codec_link_manifest output)
    set(_lines "")
    foreach(_library IN LISTS ARGN)
        string(APPEND _lines "link:${_library}\n")
    endforeach()
    set(_pending ${ARGN})
    set(_recorded)
    while(_pending)
        list(POP_FRONT _pending _library)
        if(NOT TARGET "${_library}" OR _library IN_LIST _recorded)
            continue()
        endif()
        list(APPEND _recorded "${_library}")
        get_target_property(_type "${_library}" TYPE)
        set(_file "")
        if(NOT _type STREQUAL "INTERFACE_LIBRARY")
            set(_file "$<TARGET_LINKER_FILE:${_library}>")
        endif()
        get_target_property(_interface "${_library}" INTERFACE_LINK_LIBRARIES)
        set(_links "")
        if(_interface)
            # Discover targets even inside LINK_ONLY or configuration expressions. CMake
            # evaluates those expressions to select the ordered dependencies for each build.
            string(REGEX MATCHALL "[-A-Za-z0-9_.+]+(::[-A-Za-z0-9_.+]+)*" _references "${_interface}")
            list(APPEND _pending ${_references})
            set(_links "$<TARGET_GENEX_EVAL:${_library},$<TARGET_PROPERTY:${_library},INTERFACE_LINK_LIBRARIES>>")
        endif()
        string(APPEND _lines "target:${_library}=${_file};${_links}\n")
    endwhile()
    set(${output} "${_lines}" PARENT_SCOPE)
endfunction()
