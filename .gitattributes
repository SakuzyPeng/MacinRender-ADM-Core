# Preserve upstream license/source bytes (including original CRLF and Markdown
# line breaks). License drift checks compare them with the published packages.
/third_party/licenses/rust-*/** -text -whitespace
/rust/vendor/sofar/** -text -whitespace
*.f32le binary
*.sofa binary
# Build provenance compares these exact bytes across all native checkouts.
/rust/Cargo.lock text eol=lf
/rust/rust-toolchain.toml text eol=lf
# Frozen migration references are pinned by SHA-256 in tests/reference/retention.json.
/tests/reference/** -text
# Rust layout/policy goldens are compared byte for byte with the C++ output.
/rust/crates/mradm-scene/tests/layouts-v1.txt -text
/rust/crates/mradm-scene/tests/policy-v1/** -text
/rust/crates/mradm-scene/tests/export-v1/** -text
/rust/crates/mradm-scene/tests/config-v1/** -text

# EAR source tables and spherical points are fingerprinted in PROVENANCE.json.
/rust/crates/mradm-ear/src/data.rs text eol=lf
/rust/crates/mradm-ear/assets/** -text

# Room preset components use LFS; manifests retain the validated bytes on all platforms.
/resources/rooms/**/*.json text eol=lf
/resources/rooms/**/SHA256SUMS text eol=lf
resources/rooms/**/*.f32 filter=lfs diff=lfs merge=lfs -text
resources/rooms/**/*.f64 filter=lfs diff=lfs merge=lfs -text
resources/rooms/**/*.u32 filter=lfs diff=lfs merge=lfs -text

# The synthetic room pack of the consistency matrix is pinned byte for byte (PCM consistency 4.2).
/tests/fixtures/room/** -text
/rust/crates/mradm-render/tests/routing-v1/** -text
