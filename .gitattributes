# Preserve upstream license/source bytes (including original CRLF and Markdown
# line breaks). License drift checks compare them with the published packages.
/third_party/licenses/rust-*/** -text -whitespace
/rust/vendor/sofar/** -text -whitespace
*.f32le binary
*.sofa binary
# Build provenance compares these exact bytes across all native checkouts.
/rust/Cargo.lock text eol=lf
/rust/rust-toolchain.toml text eol=lf
# Frozen migration references are pinned by SHA-256 in tests/reference/retention.json.
/tests/reference/** -text

# EAR source tables and spherical points are fingerprinted in PROVENANCE.json.
/rust/crates/mradm-ear/src/data.rs text eol=lf
/rust/crates/mradm-ear/assets/** -text
