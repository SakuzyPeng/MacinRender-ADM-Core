{
  "schema": "mradm.consistency.cli-commands.v1",
  "comment": "Fixed command table of the CLI contract (phase 6). Placeholders: {fixture:NAME} a generated ADM fixture, {json:NAME} a JSON fixture, {room:FILE} the synthetic room pack, {sofa:FILE} a SOFA fixture, {text:FILE} a non-WAVE file, {missing:FILE} a path that never exists, {out:FILE} a file the command writes (recorded). Every class compares exit codes and all working-directory file changes. class contract also compares stdout and stderr; class help and parse-error report text differences without failing (help layout and parse-error wording may change, ADR 0021 phase 6 decision 1).",
  "commands": [
    {"id": "version", "args": ["--version"]},
    {"id": "help", "args": ["--help"], "class": "help"},
    {"id": "no-subcommand", "args": [], "class": "parse-error"},
    {"id": "unknown-subcommand", "args": ["frobnicate"], "class": "parse-error"},

    {"id": "backends", "args": ["backends"]},
    {"id": "backends-help", "args": ["backends", "--help"], "class": "help"},
    {"id": "formats", "args": ["formats"]},
    {"id": "formats-extra-argument", "args": ["formats", "extra"], "class": "parse-error"},

    {"id": "layouts-wav-714", "args": ["layouts", "--format", "wav", "--layout", "7.1.4"]},
    {"id": "layouts-flac-51-ear", "args": ["layouts", "--format", "flac", "--layout", "5.1", "--renderer", "ear"]},
    {"id": "layouts-caf-binaural", "args": ["layouts", "--format", "caf", "--layout", "binaural"]},
    {"id": "layouts-iamf-714", "args": ["layouts", "--format", "iamf", "--layout", "7.1.4"]},
    {"id": "layouts-m4a-hoa3", "args": ["layouts", "--format", "m4a", "--layout", "hoa3", "--renderer", "hoa"]},
    {"id": "layouts-unknown-layout", "args": ["layouts", "--format", "wav", "--layout", "9.9.9"]},
    {"id": "layouts-flac-too-many-channels", "args": ["layouts", "--format", "flac", "--layout", "7.1.4"]},
    {"id": "layouts-bad-format", "args": ["layouts", "--format", "ogg", "--layout", "5.1"], "class": "parse-error"},
    {"id": "layouts-missing-format", "args": ["layouts", "--layout", "5.1"], "class": "parse-error"},
    {"id": "layouts-all-wav", "args": ["layouts", "--format", "wav"]},
    {"id": "layouts-bad-renderer", "args": ["layouts", "--format", "wav", "--layout", "5.1", "--renderer", "nope"], "class": "parse-error"},

    {"id": "input-layouts-text", "args": ["input-layouts"]},
    {"id": "input-layouts-json", "args": ["input-layouts", "--format", "json"]},
    {"id": "input-layouts-51", "args": ["input-layouts", "--layout", "5.1"]},
    {"id": "input-layouts-51-json", "args": ["input-layouts", "--format", "json", "--layout", "5.1"]},
    {"id": "input-layouts-unknown", "args": ["input-layouts", "--layout", "9.9.9"]},
    {"id": "input-layouts-bad-format", "args": ["input-layouts", "--format", "yaml"], "class": "parse-error"},

    {"id": "inspect-objects", "args": ["inspect", "{fixture:objects-point}"]},
    {"id": "inspect-objects-xml", "args": ["inspect", "{fixture:objects-point}", "--xml"]},
    {"id": "inspect-directspeakers", "args": ["inspect", "{fixture:directspeakers}"]},
    {"id": "inspect-hoa", "args": ["inspect", "{fixture:hoa}"]},
    {"id": "inspect-policy-template", "args": ["inspect", "{fixture:policy-objects}", "--write-semantic-policy-template", "{out:policy.json}"]},
    {"id": "inspect-missing-file", "args": ["inspect", "{missing:absent.wav}"]},
    {"id": "inspect-not-wave", "args": ["inspect", "{text:not-wave.wav}"]},
    {"id": "inspect-missing-argument", "args": ["inspect"], "class": "parse-error"},

    {"id": "export-policy", "args": ["export", "-i", "{fixture:policy-objects}", "-o", "{out:export.wav}", "--semantic-policy", "{json:policy-position.json}"]},
    {"id": "export-no-policy", "args": ["export", "-i", "{fixture:objects-point}", "-o", "{out:export.wav}"]},
    {"id": "export-missing-input", "args": ["export", "-i", "{missing:absent.wav}", "-o", "{out:export.wav}"]},
    {"id": "export-missing-output", "args": ["export", "-i", "{fixture:objects-point}"], "class": "parse-error"},

    {"id": "render-binaural-default", "args": ["render", "-i", "{fixture:objects-point}", "-o", "{out:out.wav}"]},
    {"id": "render-binaural-verbose", "args": ["render", "-v", "-i", "{fixture:objects-point}", "-o", "{out:out.wav}"]},
    {"id": "render-binaural-flac", "args": ["render", "-i", "{fixture:objects-extent}", "-o", "{out:out.flac}", "--renderer", "saf-binaural"]},
    {"id": "render-binaural-sofa", "args": ["render", "-i", "{fixture:objects-point}", "-o", "{out:out.wav}", "--sofa", "{sofa:simple.sofa}"]},
    {"id": "render-binaural-orientation", "args": ["render", "-i", "{fixture:objects-point}", "-o", "{out:out.wav}", "--listener-yaw", "30", "--listener-pitch", "-10", "--listener-roll", "5"]},
    {"id": "render-vbap-51-flac", "args": ["render", "-i", "{fixture:objects-point}", "-o", "{out:out.flac}", "--output-layout", "5.1"]},
    {"id": "render-vbap-714-mka", "args": ["render", "-i", "{fixture:objects-extent}", "-o", "{out:out.mka}", "--output-layout", "7.1.4"]},
    {"id": "render-vbap-714-flac-unsupported", "args": ["render", "-i", "{fixture:objects-point}", "-o", "{out:out.flac}", "--output-layout", "7.1.4"]},
    {"id": "render-ear-51-i24", "args": ["render", "-i", "{fixture:objects-extent}", "-o", "{out:out.wav}", "--renderer", "ear", "--output-layout", "5.1", "--output-bit-depth", "i24"]},
    {"id": "render-ear-714-i16-caf", "args": ["render", "-i", "{fixture:objects-point}", "-o", "{out:out.caf}", "--renderer", "ear", "--output-layout", "7.1.4", "--output-bit-depth", "i16"]},
    {"id": "render-hoa3-caf", "args": ["render", "-i", "{fixture:objects-point}", "-o", "{out:out.caf}", "--renderer", "hoa", "--output-layout", "hoa3"]},
    {"id": "render-hoa-input", "args": ["render", "-i", "{fixture:hoa}", "-o", "{out:out.wav}", "--output-layout", "5.1"]},
    {"id": "render-triple-balance", "args": ["render", "-i", "{fixture:objects-cartesian}", "-o", "{out:out.wav}", "--renderer", "triple-balance", "--output-layout", "7.1.4", "--speaker-spread-mode", "none"]},
    {"id": "render-directspeakers-matrix", "args": ["render", "-i", "{fixture:directspeakers}", "-o", "{out:out.wav}", "--renderer", "ear", "--output-layout", "5.1", "--direct-speakers-routing", "matrix", "--direct-speakers-matrix", "{json:ds-matrix-51.json}"]},
    {"id": "render-directspeakers-matrix-missing", "args": ["render", "-i", "{fixture:directspeakers}", "-o", "{out:out.wav}", "--output-layout", "5.1", "--direct-speakers-routing", "matrix"]},
    {"id": "render-lfe-routing-222", "args": ["render", "-i", "{fixture:directspeakers-lfe}", "-o", "{out:out.wav}", "--output-layout", "22.2", "--lfe-routing", "split-power"]},
    {"id": "render-policy-report", "args": ["render", "-i", "{fixture:policy-objects}", "-o", "{out:out.wav}", "--renderer", "ear", "--output-layout", "7.1.4", "--semantic-policy", "{json:policy-identity.json}", "--write-semantic-report", "{out:report.json}"]},
    {"id": "render-loudness-target", "args": ["render", "-i", "{fixture:objects-extent}", "-o", "{out:out.wav}", "--loudness-target", "-23"]},
    {"id": "render-peak-normalize", "args": ["render", "-i", "{fixture:objects-point}", "-o", "{out:out.wav}", "--output-layout", "5.1", "--peak-normalize-to-limit", "--peak-limit-dbtp", "-2"]},
    {"id": "render-final-gain", "args": ["render", "-i", "{fixture:objects-point}", "-o", "{out:out.wav}", "--output-layout", "5.1", "--no-peak-limit", "--final-gain-db", "-6.5"]},
    {"id": "render-trim", "args": ["render", "-i", "{fixture:objects-point}", "-o", "{out:out.wav}", "--output-layout", "5.1", "--start", "0.25", "--end", "0.75"]},
    {"id": "render-trim-invalid", "args": ["render", "-i", "{fixture:objects-point}", "-o", "{out:out.wav}", "--start", "0.75", "--end", "0.25"]},
    {"id": "render-smoothing-interp", "args": ["render", "-i", "{fixture:objects-room}", "-o", "{out:out.wav}", "--renderer", "hoa", "--output-layout", "hoa3", "--object-smoothing-frames", "2048", "--interp-ms", "0"]},
    {"id": "render-input-layout", "args": ["render", "-i", "{fixture:directspeakers}", "-o", "{out:out.wav}", "--input-layout", "5.1", "--output-layout", "binaural"]},
    {"id": "render-room", "args": ["render", "-i", "{fixture:objects-extent-multi}", "-o", "{out:out.wav}", "--renderer", "room-binaural", "--output-layout", "binaural", "--room", "{room:room.json}"]},
    {"id": "render-room-realtime-screen", "args": ["render", "-i", "{fixture:objects-extent-multi}", "-o", "{out:out.wav}", "--renderer", "room-binaural", "--room", "{room:room.json}", "--room-quality", "realtime", "--screen-config", "{json:screen-config.json}"]},
    {"id": "render-apple", "args": ["render", "-i", "{fixture:objects-point}", "-o", "{out:out.wav}", "--renderer", "apple", "--output-layout", "binaural"]},
    {"id": "render-apac", "args": ["render", "-i", "{fixture:objects-point}", "-o", "{out:out.m4a}", "--output-layout", "7.1.4"]},
    {"id": "render-iamf", "args": ["render", "-i", "{fixture:objects-point}", "-o", "{out:out.iamf}", "--output-layout", "5.1"]},
    {"id": "render-binaural-spread-cloud", "args": ["render", "-i", "{fixture:objects-extent}", "-o", "{out:out.wav}", "--binaural-spread-mode", "cloud"]},
    {"id": "render-speaker-geometry-apple", "args": ["render", "-i", "{fixture:objects-point}", "-o", "{out:out.wav}", "--output-layout", "7.1.4", "--speaker-geometry", "apple"]},
    {"id": "render-triple-balance-d", "args": ["render", "-i", "{fixture:objects-room}", "-o", "{out:out.wav}", "--renderer", "triple-balance", "--output-layout", "9.1.6", "--triple-balance-mode", "d"]},
    {"id": "render-triple-balance-d-unsupported-layout", "args": ["render", "-i", "{fixture:objects-cartesian}", "-o", "{out:out.wav}", "--renderer", "triple-balance", "--output-layout", "7.1.4", "--triple-balance-mode", "d"]},
    {"id": "render-opus-bitrate", "args": ["render", "-i", "{fixture:objects-point}", "-o", "{out:out.mka}", "--output-layout", "5.1", "--opus-bitrate-per-ch", "64"]},
    {"id": "render-room-hrir-scale", "args": ["render", "-i", "{fixture:objects-extent-multi}", "-o", "{out:out.wav}", "--renderer", "room-binaural", "--room", "{room:room.json}", "--room-hrir", "{room:hrir.json}", "--room-metres-per-unit", "2"]},
    {"id": "render-apac-options", "args": ["render", "-i", "{fixture:objects-point}", "-o", "{out:out.caf}", "--output-layout", "7.1.4", "--apac-bitrate", "1024", "--apac-drc-none", "--apac-container", "caf"]},
    {"id": "render-apple-options", "args": ["render", "-i", "{fixture:objects-point}", "-o", "{out:out.wav}", "--renderer", "apple", "--apple-spatial-preset", "headphone-movie", "--apple-speaker-rendering-flags"]},
    {"id": "render-iamf-options", "args": ["render", "-i", "{fixture:objects-point}", "-o", "{out:out.iamf}", "--output-layout", "7.1.4", "--iamf-container", "mp4", "--iamf-layers", "stereo,5.1"]},
    {"id": "render-unknown-extension", "args": ["render", "-i", "{fixture:objects-point}", "-o", "{out:out.xyz}"]},
    {"id": "render-missing-input-file", "args": ["render", "-i", "{missing:absent.wav}", "-o", "{out:out.wav}"]},
    {"id": "render-not-wave", "args": ["render", "-i", "{text:not-wave.wav}", "-o", "{out:out.wav}"]},
    {"id": "render-unknown-layout", "args": ["render", "-i", "{fixture:objects-point}", "-o", "{out:out.wav}", "--output-layout", "9.9.9"]},
    {"id": "render-help", "args": ["render", "--help"], "class": "help"},
    {"id": "render-missing-input", "args": ["render", "-o", "{out:out.wav}"], "class": "parse-error"},
    {"id": "render-bad-bit-depth", "args": ["render", "-i", "{fixture:objects-point}", "-o", "{out:out.wav}", "--output-bit-depth", "i8"], "class": "parse-error"},
    {"id": "render-bad-renderer", "args": ["render", "-i", "{fixture:objects-point}", "-o", "{out:out.wav}", "--renderer", "nope"], "class": "parse-error"},
    {"id": "render-out-of-range-decimal", "args": ["render", "-i", "{fixture:objects-point}", "-o", "{out:out.wav}", "--loudness-target", "5"], "class": "parse-error"},
    {"id": "render-bad-decimal", "args": ["render", "-i", "{fixture:objects-point}", "-o", "{out:out.wav}", "--final-gain-db", "1,5"], "class": "parse-error"},
    {"id": "render-interp-out-of-range", "args": ["render", "-i", "{fixture:objects-point}", "-o", "{out:out.wav}", "--interp-ms", "501"], "class": "parse-error"},
    {"id": "render-input-layout-excludes-channels", "args": ["render", "-i", "{fixture:directspeakers}", "-o", "{out:out.wav}", "--input-layout", "5.1", "--input-channels", "L,R,C,LFE,Ls,Rs"], "class": "parse-error"},
    {"id": "render-room-quality-needs-room", "args": ["render", "-i", "{fixture:objects-point}", "-o", "{out:out.wav}", "--room-quality", "realtime"], "class": "parse-error"},
    {"id": "render-integer-conversion", "args": ["render", "-i", "{fixture:objects-point}", "-o", "{out:out.wav}", "--interp-ms", "fast"], "class": "parse-error"},
    {"id": "render-room-needs-room-renderer", "args": ["render", "-i", "{fixture:objects-point}", "-o", "{out:out.wav}", "--room", "{room:room.json}"]},
    {"id": "render-input-channels", "args": ["render", "-i", "{fixture:directspeakers}", "-o", "{out:out.wav}", "--input-channels", "L,R,C,LFE,M+110,M-110", "--output-layout", "5.1"]},
    {"id": "render-input-channels-unknown-label", "args": ["render", "-i", "{fixture:directspeakers}", "-o", "{out:out.wav}", "--input-channels", "L,R,C,LFE,Ls,Rs"]},
    {"id": "render-unknown-option", "args": ["render", "-i", "{fixture:objects-point}", "-o", "{out:out.wav}", "--no-such-option"], "class": "parse-error"},

    {"id": "room-check-exact", "args": ["room-check", "{room:room.json}"]},
    {"id": "room-check-realtime", "args": ["room-check", "{room:room.json}", "--quality", "realtime"]},
    {"id": "room-check-hrir", "args": ["room-check", "{room:room.json}", "--hrir", "{room:hrir.json}"]},
    {"id": "room-check-sofa", "args": ["room-check", "{room:room.json}", "--sofa", "{sofa:simple.sofa}"]},
    {"id": "room-check-missing-manifest", "args": ["room-check", "{missing:room.json}"]},
    {"id": "room-check-not-a-room", "args": ["room-check", "{json:policy-identity.json}"]},
    {"id": "room-check-bad-quality", "args": ["room-check", "{room:room.json}", "--quality", "fast"], "class": "parse-error"},
    {"id": "room-check-missing-argument", "args": ["room-check"], "class": "parse-error"},

    {"id": "apac-encode-missing-arguments", "args": ["__apac-encode"], "class": "parse-error"}
  ]
}
