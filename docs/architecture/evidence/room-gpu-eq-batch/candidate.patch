+//! One forward window, not a second retained partition history. History lives
+//! in the batch backend; head EQ, overlap windows and ready samples remain here.
+use super::super::gpu_experiment::{EQ_DUE, EQ_FORK, EQ_RESET, EqCommand};
+use super::*;
+pub(super) struct EqTail {
+    previous: Vec<f32>,
+    pub window: Vec<f32>,
+    parts: usize,
+    head: usize,
+    flags: u32,
+    pub generation: u64,
+    pub awaiting: bool,
+}
+impl EqTail {
+    pub fn new(filters: &Filters) -> Result<Self> {
+        Ok(Self {
+            previous: vec![0.; 2048],
+            window: vec![0.; 4096],
+            parts: filters.partitions,
+            head: filters.partitions - 1,
+            flags: EQ_RESET,
+            generation: 0,
+            awaiting: false,
+        })
+    }
+    pub fn reset(&mut self) {
+        self.previous.fill(0.);
+        self.head = self.parts - 1;
+        self.flags = EQ_RESET;
+        self.generation = self.generation.wrapping_add(1);
+        self.awaiting = false;
+    }
+    pub fn fork(&mut self, source: &Self) -> Result<()> {
+        if self.parts != source.parts || source.awaiting || source.flags & EQ_DUE != 0 {
+            return Err(Error::InvalidArgument("Unfinished GPU EQ fork"));
+        }
+        self.previous.copy_from_slice(&source.previous);
+        self.head = source.head;
+        self.flags = EQ_FORK;
+        self.generation = self.generation.wrapping_add(1);
+        self.awaiting = false;
+        Ok(())
+    }
+    pub fn push(&mut self, input: &[f32]) -> Result<()> {
+        self.window[..2048].copy_from_slice(&self.previous);
+        self.window[2048..].copy_from_slice(input);
+        self.previous.copy_from_slice(input);
+        self.head = (self.head + 1) % self.parts;
+        self.flags |= EQ_DUE;
+        Ok(())
+    }
+    pub fn command(&self) -> EqCommand {
+        EqCommand {
+            head: self.head as u32,
+            flags: self.flags,
+        }
+    }
+    pub fn submitted(&mut self) {
+        self.awaiting = self.flags & EQ_DUE != 0;
+        self.flags = 0;
+    }
+}
