+    fn finish(&mut self, voices: &mut [Voice]) -> Result<()> {
+        if self.pending_channels == 0 {
+            return Ok(());
+        }
+        self.backend
+            .finish(&mut self.output[..self.pending_channels * 2048])?;
+        for channel in 0..self.pending_channels {
+            if self.commands[channel].flags & super::gpu_experiment::EQ_DUE != 0 {
+                voices[channel / 2]
+                    .emitter
+                    .gpu_eq_mut(channel % 2)
