+    fn submit(&mut self, voices: &mut [Voice]) -> Result<()> {
+        if self.pending_channels != 0 || voices.len() > super::gpu_experiment::MAX_VOICES {
+            return Err(Error::InvalidArgument("Unfinished GPU EQ batch"));
+        }
+        let channels = voices.len() * 2;
+        for (i, voice) in voices.iter().enumerate() {
+            for branch in 0..2 {
+                let channel = i * 2 + branch;
+                let (command, row, generation) = voice.emitter.gpu_eq(branch).gpu_eq_request();
