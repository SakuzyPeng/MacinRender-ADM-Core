+//! Independent mono EQ histories; each adjacent pair is direct/wet for one source.
+use crate::{
+    Complex32 as C, Error, Result,
+    fft::{FftPolicy, RealFft},
+};
+pub const EQ_RESET: u32 = 1;
+pub const EQ_FORK: u32 = 2;
+pub const EQ_DUE: u32 = 4;
+#[derive(Clone, Copy, Default)]
+#[repr(C)]
+pub struct EqCommand {
+    pub head: u32,
+    pub flags: u32,
+}
+pub trait EqBackend: Send {
+    /// Apply resets, then direct-to-wet forks, then new rows. Only EQ_DUE rows
+    /// produce a result. Inputs are copied before returning from submit.
+    fn submit(&mut self, commands: &[EqCommand], input: &[f32]) -> Result<()>;
+    fn finish(&mut self, output: &mut [f32]) -> Result<()>;
+}
+
+pub(super) struct ReferenceEq {
+    parts: usize,
+    filters: Vec<C>,
+    history: Vec<C>,
+    output: Vec<f32>,
+    sum: Vec<C>,
+    time: Vec<f32>,
+    fft: RealFft,
+    pending: usize,
+}
+impl ReferenceEq {
+    pub fn new(filters: &[C], policy: FftPolicy) -> Result<Self> {
+        Ok(Self {
+            parts: filters.len() / 2049,
+            filters: filters.to_vec(),
+            history: vec![C::default(); super::MAX_VOICES * 2 * filters.len()],
+            output: vec![0.; super::MAX_VOICES * 2 * 2048],
+            sum: vec![C::default(); 2049],
+            time: vec![0.; 4096],
+            fft: RealFft::with_policy(4096, policy)?,
+            pending: 0,
+        })
+    }
+}
+impl EqBackend for ReferenceEq {
+    fn submit(&mut self, commands: &[EqCommand], input: &[f32]) -> Result<()> {
+        if self.pending != 0
+            || commands.is_empty()
+            || !commands.len().is_multiple_of(2)
+            || commands.len() > super::MAX_VOICES * 2
+            || input.len() != commands.len() * 4096
+            || commands.iter().enumerate().any(|(i, c)| {
+                c.head as usize >= self.parts
+                    || c.flags & !7 != 0
+                    || (i % 2 == 0 && c.flags & EQ_FORK != 0)
+            })
+        {
+            return Err(Error::InvalidArgument("Invalid GPU EQ batch"));
+        }
+        let stride = self.filters.len();
+        for (channel, command) in commands.iter().enumerate() {
+            let offset = channel * stride;
+            if command.flags & EQ_RESET != 0 {
+                self.history[offset..offset + stride].fill(C::default());
+            }
+        }
+        for channel in (1..commands.len()).step_by(2) {
+            if commands[channel].flags & EQ_FORK != 0 {
+                let offset = channel * stride;
+                self.history.copy_within(offset - stride..offset, offset);
+            }
+        }
+        for (channel, command) in commands.iter().enumerate() {
+            if command.flags & EQ_DUE == 0 {
+                continue;
+            }
+            let head = command.head as usize;
+            let offset = (channel * self.parts + head) * 2049;
+            self.fft.forward(
+                &input[channel * 4096..(channel + 1) * 4096],
+                &mut self.history[offset..offset + 2049],
+            )?;
+        }
+        for (channel, command) in commands.iter().enumerate() {
+            if command.flags & EQ_DUE == 0 {
+                continue;
+            }
+            self.sum.fill(C::default());
+            for part in 0..self.parts {
+                let at = (command.head as usize + self.parts - part) % self.parts;
+                let offset = (channel * self.parts + at) * 2049;
+                for bin in 0..2049 {
+                    self.sum[bin] += self.history[offset + bin] * self.filters[part * 2049 + bin];
+                }
+            }
+            self.fft.inverse(&self.sum, &mut self.time)?;
+            self.output[channel * 2048..(channel + 1) * 2048].copy_from_slice(&self.time[2048..]);
+        }
+        self.pending = commands.len();
+        Ok(())
+    }
+    fn finish(&mut self, output: &mut [f32]) -> Result<()> {
+        if self.pending == 0 || output.len() != self.pending * 2048 {
+            return Err(Error::InvalidArgument("Invalid GPU EQ completion"));
+        }
+        output.copy_from_slice(&self.output[..output.len()]);
+        self.pending = 0;
+        Ok(())
+    }
+}
