@@ -0,0 +1,90 @@
+#pragma once
+#include "session_late.h"
+// Included inside the private backend namespace.
+// Each adjacent channel pair belongs to one source: direct, then wet.
+struct EqHeader {
+    unsigned channels;
+    RoomGpuEqCommand commands[64];
+};
+static_assert(sizeof(RoomGpuEqCommand) == 8 && sizeof(EqHeader) == 516);
+struct EqEngine {
+    unsigned parts, pending_channels = 0;
+    LateStream stream;
+    Device filters, history, input, parameters, fresh, spectrum, time, output;
+    Pinned host_input, host_parameters, host_output;
+    cudaDeviceProp properties = late_device_properties();
+    Module module;
+    Plan forward, inverse;
+    LateGraph graph;
+    CUfunction input_fn, convolve_fn, extract_fn;
+    EqEngine(const fs::path& fixture, const fs::path& source, unsigned p, const float* f)
+        : parts(p), filters(size_t(p) * 2049 * 8), history(size_t(64) * p * 2049 * 8), input(64 * 4096 * 4),
+          parameters(sizeof(EqHeader)), fresh(64 * 2049 * 8), spectrum(64 * 2049 * 8), time(64 * 4096 * 4),
+          output(64 * 2048 * 4), host_input(input.bytes), host_parameters(parameters.bytes), host_output(output.bytes),
+          module(source, Config(fixture / "config.txt"), 32, properties.major, properties.minor),
+          forward(4096, CUFFT_R2C, 64, stream.value), inverse(4096, CUFFT_C2R, 64, stream.value) {
+        runtime(cudaMemcpy(filters.data, f, filters.bytes, cudaMemcpyHostToDevice));
+        runtime(cudaMemset(history.data, 0, history.bytes));
+        std::memset(host_input.data, 0, host_input.bytes);
+        std::memset(host_parameters.data, 0, host_parameters.bytes);
+        input_fn = module.function("eq_input");
+        convolve_fn = module.function("eq_convolve");
+        extract_fn = module.function("late_extract");
+        execute();
+        runtime(cudaStreamSynchronize(stream.value));
+        runtime(cudaStreamBeginCapture(stream.value, cudaStreamCaptureModeThreadLocal));
+        execute();
+        runtime(cudaStreamEndCapture(stream.value, &graph.graph));
+        runtime(cudaGraphInstantiate(&graph.execution, graph.graph, 0));
+    }
+    ~EqEngine() {
+        cudaSetDevice(0);
+        if (pending_channels)
+            cudaStreamSynchronize(stream.value);
+    }
+    void execute() {
+        runtime(cudaMemcpyAsync(input.data, host_input.data, input.bytes, cudaMemcpyHostToDevice, stream.value));
+        runtime(cudaMemcpyAsync(
+            parameters.data, host_parameters.data, parameters.bytes, cudaMemcpyHostToDevice, stream.value));
+        fft_check(cufftExecR2C(forward.value, static_cast<float*>(input.data), static_cast<cufftComplex*>(fresh.data)));
+        auto launch = [&](CUfunction fn, unsigned x, unsigned y, std::initializer_list<void*> values) {
+            std::array<void*, 8> args{};
+            std::copy(values.begin(), values.end(), args.begin());
+            driver(cuLaunchKernel(
+                fn, x, y, 1, 128, 1, 1, 0, reinterpret_cast<CUstream>(stream.value), args.data(), nullptr));
+        };
+        launch(input_fn, 17, 32, {&parameters.data, &fresh.data, &history.data, &parts});
+        launch(convolve_fn, 17, 64, {&parameters.data, &history.data, &filters.data, &spectrum.data, &parts});
+        fft_check(
+            cufftExecC2R(inverse.value, static_cast<cufftComplex*>(spectrum.data), static_cast<float*>(time.data)));
+        launch(extract_fn, 16, 64, {&time.data, &output.data});
+        runtime(cudaMemcpyAsync(host_output.data, output.data, output.bytes, cudaMemcpyDeviceToHost, stream.value));
+    }
+    void submit(const RoomGpuEqCommand* commands, size_t channels, const float* windows, size_t samples) {
+        if (pending_channels || !channels || channels > 64 || channels % 2 || samples != channels * 4096)
+            throw std::runtime_error("Invalid GPU EQ submission");
+        for (size_t i = 0; i < channels; ++i) {
+            if (commands[i].head >= parts || (commands[i].flags & ~7u) || (i % 2 == 0 && commands[i].flags & 2))
+                throw std::runtime_error("Invalid GPU EQ command");
+        }
+        runtime(cudaSetDevice(0));
+        auto* header = static_cast<EqHeader*>(host_parameters.data);
+        header->channels = static_cast<unsigned>(channels);
+        std::memcpy(header->commands, commands, channels * sizeof(RoomGpuEqCommand));
+        auto* input_rows = static_cast<float*>(host_input.data);
+        for (size_t i = 0; i < channels; ++i) {
+            if (commands[i].flags & 4)
+                std::memcpy(input_rows + i * 4096, windows + i * 4096, 4096 * sizeof(float));
+        }
+        runtime(cudaGraphLaunch(graph.execution, stream.value));
+        pending_channels = static_cast<unsigned>(channels);
+    }
+    void finish(float* destination, size_t samples) {
+        if (!pending_channels || samples != size_t(pending_channels) * 2048)
+            throw std::runtime_error("Invalid GPU EQ completion");
+        runtime(cudaSetDevice(0));
+        runtime(cudaStreamSynchronize(stream.value));
+        pending_channels = 0;
+        std::memcpy(destination, host_output.data, samples * sizeof(float));
+    }
+};
