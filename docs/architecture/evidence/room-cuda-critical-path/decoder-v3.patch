+pub(crate) struct DecoderVoice {
+    room: Arc<PreparedRoom>,
+    direction: [f64; 3],
+    face: usize,
+    history: InputHistory,
+    reader: super::partition::Dynamic,
+    timeline: Timeline,
+    pub frame: Frame,
+    need_reset: bool,
+}
+impl DecoderVoice {
+    pub fn new(room: Arc<PreparedRoom>, direction: [f64; 3]) -> Result<Self> {
+        Ok(Self {
+            history: InputHistory::with_policy(
+                room.decoder_hrir.data.output_taps,
+                room.quality.fft(),
+            )?,
+            reader: super::partition::Dynamic::reader_at_rate(
+                2,
+                1,
+                room.quality.fft(),
+                room.profile.sample_rate,
+            )?,
+            timeline: Timeline::with_job_capacity(1, 1),
+            frame: Frame::decoder(),
+            direction,
+            face: usize::MAX,
+            need_reset: true,
+            room,
+        })
+    }
+    pub fn reset(&mut self) {
+        self.reader.reset();
+        self.history.reset();
+        self.timeline.reset();
+        self.need_reset = true;
+        self.frame.clear();
+        self.frame.reset = true;
+    }
+    pub fn begin(&mut self, input: &[f32]) -> Result<()> {
+        self.frame.clear();
+        self.timeline.begin();
+        self.frame.reset = self.need_reset;
+        self.need_reset = false;
+        self.reader.begin_with_history(&mut self.history, input)?;
+        self.frame.inputs(&self.history, &self.history);
+        Ok(())
+    }
+    pub fn target(&mut self, rotation: Rotation) -> Result<()> {
+        let bank = &self.room.decoder_hrir;
+        let data = &bank.data;
+        let (vertices, weights) = bank.weights(rotation.apply(self.direction), &mut self.face)?;
+        let layer = data.collection.as_ref().map_or(0, |c| c.reference);
+        let mut job = Job {
+            gain: 1.,
+            ..Default::default()
+        };
+        for ear in 0..2 {
+            let mut delay = 0.;
+            for v in 0..3 {
+                delay += data.delays[vertices[v]][ear] * weights[v];
+            }
+            let mut count = 0;
+            for v in 0..3 {
+                if weights[v] <= 0. {
+                    continue;
+                }
+                let shift = delay - data.delays[vertices[v]][ear];
+                let integer = libm::floor(shift);
+                let (f, alpha) = fraction(shift - integer);
+                job.terms[ear * 6 + count] = Term {
+                    row: ((layer * data.directions.len() + vertices[v]) * 2 + ear) as u32,
+                    fraction: f,
+                    alpha,
+                    weight: weights[v] as f32,
+                    shift: (data.guard as i64 + integer as i64 - 40)
+                        .rem_euclid(bank.fft_length as i64) as u32,
+                };
+                count += 1;
+            }
+            job.counts |= (count as u32) << (ear * 8);
+        }
+        if self.timeline.valid && self.timeline.last_jobs.as_slice() == [job] {
+            return Ok(());
+        }
+        if self.frame.jobs.len() == self.frame.jobs.capacity()
+            || self.frame.requests.len() == UPDATE_LIMIT
+        {
+            return Err(Error::Unsupported(
+                "GPU decoder frame update capacity exceeded",
+            ));
+        }
+        let support = data.output_taps;
+        let slot = self.timeline.target(
+            self.reader.gpu_clock().0,
+            support,
+            super::filter_fade(self.room.profile.sample_rate) as u64,
+            &mut self.frame,
+        )?;
+        let first = self.frame.ranges.len();
+        self.frame.ranges.push(Range {
+            first: self.frame.jobs.len() as u32,
+            count: 1,
+        });
+        self.frame.jobs.push(job);
+        let request = Request {
+            update: Update {
+                slot: slot as u32,
+                branch: 0,
+                range_first: first as u32,
+                range_count: 1,
+                parts: support.div_ceil(BLOCK) as u32,
+                support: support as u32,
+            },
+            sources: 0..0,
+            rotation,
+        };
+        if self.timeline.updates[slot] != usize::MAX {
+            self.frame.requests[self.timeline.updates[slot]] = request;
+        } else {
+            self.timeline.updates[slot] = self.frame.requests.len();
+            self.frame.requests.push(request);
+        }
+        self.timeline.last_jobs.clear();
+        self.timeline.last_jobs.push(job);
+        self.timeline.valid = true;
+        Ok(())
+    }
+    pub fn render(&mut self, offset: usize, frames: usize) -> Result<()> {
+        self.timeline.render(
+            0,
+            self.reader.gpu_clock().1,
+            offset,
+            frames,
+            super::filter_fade(self.room.profile.sample_rate) as u64,
+            &mut self.frame,
+        )?;
+        self.reader.gpu_advance(offset, frames)
+    }
+}
