diff --git a/rust/crates/mradm-room-cuda/examples/timeline.rs b/rust/crates/mradm-room-cuda/examples/timeline.rs
new file mode 100644
index 00000000..ca2703ac
--- /dev/null
+++ b/rust/crates/mradm-room-cuda/examples/timeline.rs
@@ -0,0 +1,44 @@
+//! Temporary Windows diagnostic binding. Never linked into acceptance binaries.
+use std::{ffi::c_void, os::windows::ffi::OsStrExt, sync::OnceLock};
+type Event = unsafe extern "C" fn(u32, u32);
+type Capture = unsafe extern "C" fn(u32) -> i32;
+static FUNCTIONS: OnceLock<(Event, Capture)> = OnceLock::new();
+#[link(name = "kernel32")]
+unsafe extern "system" {
+    fn LoadLibraryW(path: *const u16) -> *mut c_void;
+    fn GetProcAddress(module: *mut c_void, name: *const u8) -> *mut c_void;
+}
+fn hook(stage: mradm_dsp::room::profile::Stage, begin: bool) {
+    unsafe { (FUNCTIONS.get().unwrap().0)(stage as u32, u32::from(begin)) };
+}
+pub fn initialize() -> Result<(), Box<dyn std::error::Error>> {
+    let path = std::env::current_exe()?.with_file_name("room_timeline.dll");
+    let wide: Vec<u16> = path.as_os_str().encode_wide().chain(Some(0)).collect();
+    let library = unsafe { LoadLibraryW(wide.as_ptr()) };
+    if library.is_null() {
+        return Err("Cannot load diagnostic timeline helper".into());
+    }
+    let event = unsafe { GetProcAddress(library, c"room_timeline_event".as_ptr().cast()) };
+    let capture = unsafe { GetProcAddress(library, c"room_timeline_capture".as_ptr().cast()) };
+    if event.is_null() || capture.is_null() {
+        return Err("Incomplete timeline helper".into());
+    }
+    let functions = unsafe {
+        (
+            std::mem::transmute::<*mut c_void, Event>(event),
+            std::mem::transmute::<*mut c_void, Capture>(capture),
+        )
+    };
+    FUNCTIONS
+        .set(functions)
+        .map_err(|_| "Timeline initialized twice")?;
+    mradm_dsp::room::profile::set_timeline(hook);
+    Ok(())
+}
+pub fn capture(begin: bool) -> Result<(), Box<dyn std::error::Error>> {
+    let code = unsafe { (FUNCTIONS.get().unwrap().1)(u32::from(begin)) };
+    if code != 0 {
+        return Err(format!("CUDA capture marker failed: {code}").into());
+    }
+    Ok(())
+}
