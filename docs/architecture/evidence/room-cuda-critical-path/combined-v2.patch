+        std::array<void*, 12> arguments{};
+        std::copy(values.begin(), values.end(), arguments.begin());
+        driver(cuLaunchKernel(function,
+                              x,
+                              y,
+                              1,
+                              shape[0],
+                              shape[1],
+                              1,
+                              shape[2],
