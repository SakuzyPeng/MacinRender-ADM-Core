+if(NOT MR_ADM_ENABLE_ROOM_CUDA)
+    return()
+endif()
+if(NOT WIN32)
+    message(FATAL_ERROR "MR_ADM_ENABLE_ROOM_CUDA currently supports Windows only")
+endif()
+find_package(CUDAToolkit 12 REQUIRED)
+add_library(mr_adm_room_cuda SHARED src/adm_render_room/cuda/backend.cpp)
+target_compile_features(mr_adm_room_cuda PRIVATE cxx_std_20)
+target_include_directories(mr_adm_room_cuda PRIVATE src/adm_render_room/cuda)
+target_link_libraries(mr_adm_room_cuda PRIVATE CUDA::cuda_driver CUDA::cudart CUDA::nvrtc CUDA::cufft)
+set_target_properties(mr_adm_room_cuda PROPERTIES OUTPUT_NAME mradm_room_cuda)
+if(MSVC)
+    target_compile_options(mr_adm_room_cuda PRIVATE /W4 /EHsc /utf-8)
+endif()
+
+# No dependency is linked into the public C API or loaded for CPU/exact. Keep
+# the optional plugin and its redistributable runtime DLLs side by side.
+set(_mr_cuda_runtime_files)
+foreach(_component cudart cufft nvrtc nvrtc-builtins)
+    file(GLOB _matches "${CUDAToolkit_BIN_DIR}/${_component}64*.dll")
+    if(NOT _matches)
+        message(FATAL_ERROR "Cannot locate CUDA runtime component ${_component}")
+    endif()
+    list(APPEND _mr_cuda_runtime_files ${_matches})
+endforeach()
+foreach(_runtime IN LISTS _mr_cuda_runtime_files)
+    add_custom_command(TARGET mr_adm_room_cuda POST_BUILD
+        COMMAND "${CMAKE_COMMAND}" -E copy_if_different "${_runtime}" "$<TARGET_FILE_DIR:mr_adm_room_cuda>"
+        VERBATIM)
+endforeach()
+set(MR_ADM_ROOM_CUDA_RUNTIME_FILES "${_mr_cuda_runtime_files}" CACHE INTERNAL "Optional ROOM CUDA dependencies" FORCE)
diff --git a/rust/crates/mradm-dsp/examples/room_support/room_bench.rs b/rust/crates/mradm-dsp/examples/room_support/room_bench.rs
new file mode 100644
index 0000000..6a4d25d
--- /dev/null
+++ b/rust/crates/mradm-dsp/examples/room_support/room_bench.rs
@@ -0,0 +1,450 @@
+//! Release-only room CPU deadline probe. No audio device is involved: missed
+//! deadlines here are DSP misses, not claimed device underruns/latency.
+use super::assets;
+use super::audio_workers;
+#[cfg(feature = "room-gpu-experiment")]
+use super::gpu;
+#[cfg(feature = "room-profile")]
+use super::trace;
+use mradm_dsp::{
+    geometry,
+    room::{
+        BLOCK,
+        control::{RoomCommand, RoomDescription, State},
+        hrir::HrirBank,
+        prepared::PreparedRoom,
+        quality::Quality,
+        session::{Instance, PreparedSet, Session},
+    },
+};
+use std::{path::Path, sync::Arc, time::Instant};
+// Read counters outside the measured process call. Native host/Scene benchmarks
+// provide these counters on macOS and Windows; this lightweight probe also runs
+// on a headless Linux validation host without building device dependencies.
+fn process_counters(ticks: Option<f64>) -> (Option<f64>, Option<u64>) {
+    #[cfg(target_os = "linux")]
+    {
+        let cpu = ticks.and_then(|ticks| {
+            let stat = std::fs::read_to_string("/proc/self/stat").ok()?;
+            let values: Vec<_> = stat.rsplit_once(')')?.1.split_whitespace().collect();
+            let user: u64 = values.get(11)?.parse().ok()?;
+            let system: u64 = values.get(12)?.parse().ok()?;
+            Some((user + system) as f64 / ticks)
+        });
+        let rss = std::fs::read_to_string("/proc/self/status")
+            .ok()
+            .and_then(|value| {
+                value.lines().find_map(|line| {
+                    line.strip_prefix("VmRSS:")?
+                        .split_whitespace()
+                        .next()?
+                        .parse::<u64>()
+                        .ok()
+                        .map(|kb| kb * 1024)
+                })
+            });
+        (cpu, rss)
+    }
+    #[cfg(target_os = "macos")]
+    {
+        let _ = ticks;
+        let mut usage = std::mem::MaybeUninit::<libc::rusage>::uninit();
+        // getrusage initializes the complete platform-defined structure.
+        if unsafe { libc::getrusage(libc::RUSAGE_SELF, usage.as_mut_ptr()) } != 0 {
+            return (None, None);
+        }
+        let usage = unsafe { usage.assume_init() };
+        let seconds = |t: libc::timeval| t.tv_sec as f64 + t.tv_usec as f64 / 1e6;
+        (
+            Some(seconds(usage.ru_utime) + seconds(usage.ru_stime)),
+            u64::try_from(usage.ru_maxrss).ok(),
+        )
+    }
+    #[cfg(not(any(target_os = "linux", target_os = "macos")))]
+    {
+        let _ = ticks;
+        (None, None)
+    }
+}
+
+pub fn run() -> std::result::Result<(), Box<dyn std::error::Error>> {
+    if cfg!(debug_assertions) {
+        return Err("Use Release for performance evidence".into());
+    }
+    let mut arguments: Vec<_> = std::env::args().collect();
+    let automatic = arguments.iter().any(|v| v == "--automatic-mapping");
+    arguments.retain(|v| v != "--automatic-mapping");
+    let audio_workers = arguments.iter().any(|v| v == "--audio-workers");
+    arguments.retain(|v| v != "--audio-workers");
+    if audio_workers {
+        audio_workers::enable()?;
+    }
+    #[cfg(feature = "room-gpu-experiment")]
+    let gpu = gpu::Options::parse(&mut arguments)?;
+    let hrir_path = if let Some(index) = arguments.iter().position(|v| v == "--hrir") {
+        let path = arguments
+            .get(index + 1)
+            .ok_or("--hrir needs a resource path")?
+            .clone();
+        arguments.drain(index..index + 2);
+        Some(path)
+    } else {
+        None
+    };
+    let quality = if let Some(index) = arguments.iter().position(|v| v == "--quality") {
+        let value = arguments
+            .get(index + 1)
+            .ok_or("--quality needs exact or realtime")?
+            .parse::<Quality>()?;
+        arguments.drain(index..index + 2);
+        value
+    } else {
+        Quality::Exact
+    };
+    let scenario = if let Some(index) = arguments.iter().position(|v| v == "--scenario") {
+        let value = arguments
+            .get(index + 1)
+            .ok_or("--scenario needs all, static, pose, switch, ramps or distance-ramps")?
+            .clone();
+        if !["all", "static", "pose", "switch", "ramps", "distance-ramps"].contains(&value.as_str())
+        {
+            return Err(
+                "--scenario needs all, static, pose, switch, ramps or distance-ramps".into(),
+            );
+        }
+        arguments.drain(index..index + 2);
+        value
+    } else {
+        "all".to_owned()
+    };
+    let tracing = arguments.last().is_some_and(|v| v == "--trace");
+    if tracing {
+        arguments.pop();
+        if !cfg!(feature = "room-profile") {
+            return Err("--trace requires a Release build with --features room-profile".into());
+        }
+    }
+    #[cfg(feature = "room-profile")]
+    let clock_read_ns = tracing.then(trace::enable_cpu_clock).flatten();
+    let ticks = if cfg!(target_os = "linux") {
+        std::process::Command::new("getconf")
+            .arg("CLK_TCK")
+            .output()
+            .ok()
+            .filter(|v| v.status.success())
+            .and_then(|v| String::from_utf8(v.stdout).ok()?.trim().parse::<f64>().ok())
+            .filter(|v| v.is_finite() && *v > 0.)
+    } else {
+        None
+    };
+    if arguments.len() < 2 || arguments.len() > 6 {
+        return Err(
+            "usage: room_bench ROOM_JSON [CALLS=384] [FRAMES=256|512] [SOURCES=1|16|32] [SWITCH_PERIOD_CALLS=0] [--trace] [--quality exact|realtime] [--scenario all|static|pose|switch|ramps|distance-ramps] [--hrir SOFA_OR_MANIFEST]".into(),
+        );
+    }
+    let file = Path::new(&arguments[1]);
+    let root = file.parent().ok_or("missing parent")?;
+    let blocks = arguments
+        .get(2)
+        .map(|s| s.parse())
+        .transpose()?
+        .unwrap_or(384usize);
+    if blocks == 0 || blocks > 112_500 {
+        return Err("BLOCKS must be 1..112500".into());
+    }
+    let frames = arguments
+        .get(3)
+        .map(|v| v.parse::<usize>())
+        .transpose()?
+        .unwrap_or(BLOCK);
+    if frames != BLOCK && frames != 2 * BLOCK {
+        return Err("FRAMES must be 256 or 512".into());
+    }
+    let profile = Arc::new(assets::profile(file)?);
+    let selected = hrir_path
+        .as_ref()
+        .map(std::path::PathBuf::from)
+        .unwrap_or_else(|| root.join(&profile.default_hrir));
+    let data = Arc::new(assets::hrir_at_rate(&selected, profile.sample_rate)?);
+    let (length, _, _) = PreparedRoom::required_fft(&profile, &data)?;
+    let bank = Arc::new(HrirBank::with_policy(data, length, quality.fft())?);
+    let prepared = Arc::new(PreparedSet::new(Arc::new(PreparedRoom::with_quality(
+        profile.clone(),
+        bank.clone(),
+        quality,
+    )?))?);
+    let mut other = (*profile).clone();
+    other.identity.push_str("-benchmark");
+    other.absorption = [[0.9; 8]; 6];
+    let other = Arc::new(PreparedSet::new(Arc::new(PreparedRoom::with_quality(
+        Arc::new(other),
+        bank,
+        quality,
+    )?))?);
+    #[cfg(feature = "room-gpu-experiment")]
+    let (prepared, other) = (gpu.prepare(prepared)?, gpu.prepare(other)?);
+    let scheduling = if audio_workers {
+        audio_workers::report()?
+    } else {
+        serde_json::Value::Null
+    };
+    let experiment = serde_json::Value::Null;
+    #[cfg(feature = "room-gpu-experiment")]
+    let experiment = if gpu.report().is_null() {
+        experiment
+    } else {
+        gpu.report()
+    };
+    let only_sources = arguments.get(4).map(|v| v.parse::<usize>()).transpose()?;
+    if only_sources.is_some_and(|n| ![1, 16, 32].contains(&n)) {
+        return Err("SOURCES must be 1, 16 or 32".into());
+    }
+    let switch_period = arguments
+        .get(5)
+        .map(|v| v.parse::<usize>())
+        .transpose()?
+        .unwrap_or(0);
+    for sources in [1, 16, 32] {
+        if only_sources.is_some_and(|n| n != sources) {
+            continue;
+        }
+        // The last scenario ramps every source with its own event offset, as
+        // dense ADM automation does; per-source update grids bound its cost.
+        for (name, moving, switching, ramps) in [
+            ("static", false, false, false),
+            ("pose", true, false, false),
+            ("switch", true, true, false),
+            ("ramps", true, false, true),
+            ("distance-ramps", true, false, true),
+        ] {
+            if scenario != "all" && scenario != name {
+                continue;
+            }
+            let mut session = Session::new(
+                prepared.clone(),
+                if automatic { 0. } else { 1.5 },
+                true,
+                false,
+            )?;
+            let authored = |position: [f64; 3]| -> [f32; 3] {
+                if !automatic {
+                    return position.map(|v| (v / 1.5) as f32);
+                }
+                let world = [position[1], -position[0], position[2]];
+                let room = &prepared.room.profile;
+                let normalized: [f64; 3] = std::array::from_fn(|axis| {
+                    world[axis]
+                        / if world[axis] >= 0. {
+                            room.dimensions[axis] - room.clearance - room.listener[axis]
+                        } else {
+                            room.listener[axis] - room.clearance
+                        }
+                });
+                [
+                    -normalized[1] as f32,
+                    normalized[0] as f32,
+                    normalized[2] as f32,
+                ]
+            };
+            let around = |i: usize, turn: f32| {
+                let v = geometry::portable_direction(
+                    i as f32 * 360. / sources as f32 + turn,
+                    (i % 3) as f32 * 15. - 15.,
+                );
+                if automatic {
+                    return authored([-v[1] * 2.1, v[0] * 2.1, v[2] * 2.1]);
+                }
+                [
+                    (-v[1] * 1.4) as f32,
+                    (v[0] * 1.4) as f32,
+                    (v[2] * 1.4) as f32,
+                ]
+            };
+            let radial = |i: usize, block: usize| {
+                let v = geometry::portable_direction(
+                    -60. + 120. * i as f32 / sources.max(1) as f32,
+                    0.,
+                );
+                let phase = ((block + i * 11) % 128) as f64 / 64.;
+                let metres = 0.2 + 1.4 * (1. - (phase - 1.).abs());
+                if automatic {
+                    return authored([-v[1] * metres, v[0] * metres, 0.]);
+                }
+                [
+                    (-v[1] * metres / 1.5) as f32,
+                    (v[0] * metres / 1.5) as f32,
+                    0.,
+                ]
+            };
+            let descriptions: Vec<_> = (0..sources)
+                .map(|i| RoomDescription {
+                    id: i as u64 + 1,
+                    position: if name == "distance-ramps" {
+                        radial(i, 0)
+                    } else {
+                        around(i, 0.)
+                    },
+                    ..RoomDescription::default()
+                })
+                .collect();
+            let offsets: Vec<_> = (0..sources).map(|i| (i * 131 + 17) % frames).collect();
+            let mut distinct = offsets.clone();
+            distinct.sort_unstable();
+            distinct.dedup();
+            let mut commands = Vec::with_capacity(sources);
+            session.configure(&descriptions)?;
+            let mut candidate = if switching {
+                Some(Box::new(Instance::new(other.clone(), sources)?))
+            } else {
+                None
+            };
+            let mut revision = 0u64;
+            let mut preparation_seconds = 0.;
+            let mut input = vec![0f32; frames];
+            let mut output = vec![0f32; 2 * frames];
+            let mut elapsed = Vec::with_capacity(blocks);
+            #[cfg(feature = "room-profile")]
+            let mut trace = tracing.then(|| trace::Trace::new(blocks, clock_read_ns));
+            let mut peak = 0f32;
+            let mut cpu_start = None;
+            let mut rss_peak = 0u64;
+            for block in 0..blocks + 32 {
+                if block == 32 {
+                    mradm_dsp::room::profile::reset();
+                    let (cpu, rss) = process_counters(ticks);
+                    cpu_start = cpu;
+                    rss_peak = rss.unwrap_or(0);
+                }
+                for (i, v) in input.iter_mut().enumerate() {
+                    *v = (((block * frames + i) % 179) as f32 - 89.) * 0.00001;
+                }
+                if moving {
+                    session.set_pose([
+                        block as f32 * 0.25,
+                        block as f32 * 0.05,
+                        block as f32 * 0.02,
+                    ])?;
+                }
+                commands.clear();
+                if ramps {
+                    // Each call ramps every source to its next position over the call.
+                    commands.extend((0..sources).map(|i| RoomCommand {
+                        element: i as u32,
+                        offset: offsets[i] as u32,
+                        duration: frames as u32,
+                        changed: 4,
+                        state: State {
+                            position: if name == "distance-ramps" {
+                                radial(i, block + 1)
+                            } else {
+                                around(i, (block + 1) as f32 * 0.5)
+                            },
+                            ..State::default()
+                        },
+                        ..RoomCommand::default()
+                    }));
+                    commands.sort_by_key(|c| c.offset);
+                }
+                if switching
+                    && (block == 64
+                        || (switch_period != 0 && block > 64 && (block - 64) % switch_period == 0))
+                {
+                    if session.info().phase != 0 {
+                        return Err("Switch period shorter than transition and tail".into());
+                    }
+                    revision += 1;
+                    let prepare_start = Instant::now();
+                    let next = candidate.take().map_or_else(
+                        || {
+                            Instance::new(
+                                if revision % 2 == 1 {
+                                    other.clone()
+                                } else {
+                                    prepared.clone()
+                                },
+                                sources,
+                            )
+                            .map(Box::new)
+                        },
+                        Ok,
+                    )?;
+                    session.queue_room(next, revision)?;
+                    preparation_seconds += prepare_start.elapsed().as_secs_f64();
+                }
+                #[cfg(feature = "room-profile")]
+                let trace_start = (block >= 32)
+                    .then(|| trace.as_ref().map(|_| trace::start(session.info().phase)))
+                    .flatten();
+                let start = Instant::now();
+                session.process(
+                    frames,
+                    (0..sources).map(|_| Some(input.as_slice())),
+                    &[],
+                    &commands,
+                    &mut output,
+                )?;
+                let duration = start.elapsed().as_secs_f64();
+                if block >= 32 {
+                    elapsed.push(duration);
+                    #[cfg(feature = "room-profile")]
+                    if let (Some(trace), Some(before)) = (&mut trace, trace_start) {
+                        trace.finish(block - 32, before, session.info().phase, duration);
+                    }
+                }
+                if block % 64 == 0 {
+                    rss_peak = rss_peak.max(process_counters(ticks).1.unwrap_or(0));
+                }
+                peak = output.iter().fold(peak, |a, b| a.max(b.abs()));
+                let _retired = session.take_retired();
+            }
+            let counters = process_counters(ticks);
+            rss_peak = rss_peak.max(counters.1.unwrap_or(0));
+            let cpu = cpu_start.zip(counters.0).map(|(start, end)| end - start);
+            // Preserve the worst call identities from already-recorded times.
+            // Sorting/JSON construction happen after processing and CPU sampling.
+            let mut indexed: Vec<_> = elapsed.iter().copied().enumerate().collect();
+            indexed.sort_unstable_by(|a, b| b.1.total_cmp(&a.1).then(a.0.cmp(&b.0)));
+            let slowest_calls: Vec<_> = indexed.iter().take(32).map(|(index, seconds)| {
+                serde_json::json!({"measured_call":index,"benchmark_call":index+32,"ms":seconds*1000.})
+            }).collect();
+            let total: f64 = elapsed.iter().sum();
+            elapsed.sort_by(f64::total_cmp);
+            let deadline = frames as f64 / f64::from(prepared.room.profile.sample_rate);
+            let profile = mradm_dsp::room::profile::snapshot();
+            #[cfg(feature = "room-profile")]
+            let trace_report = trace.map(|trace| trace.report(deadline));
+            #[cfg(not(feature = "room-profile"))]
+            let trace_report: Option<serde_json::Value> = None;
+            let segments = cfg!(feature = "room-profile").then(|| {
+                let index = mradm_dsp::room::profile::NAMES
+                    .iter()
+                    .position(|name| *name == "voice_segment")
+                    .unwrap();
+                profile[index].0
+            });
+            let stages: serde_json::Map<String, serde_json::Value> = mradm_dsp::room::profile::NAMES.iter().zip(profile).map(|(name, (calls, nanos))| ((*name).to_owned(), serde_json::json!({"calls": calls, "worker_summed_ms": nanos as f64 / 1e6}))).collect();
+            let mut report = serde_json::json!({"scenario":name,"sources":sources,"continuous_pose":moving,"room_transition":switching,
+                "quality":quality.name(),"processing_policy":quality.policy(),"reflection_update_frames":quality.reflection_frames_at(prepared.room.profile.sample_rate),
+                "source_ramps":ramps,"distinct_event_offsets":if ramps{distinct.len()}else{0},
+                "voice_segments":segments,
+                "voice_segments_per_source_block":segments.map(|v|v as f64/(sources*blocks*frames/BLOCK) as f64),
+                "room_switches":revision,"switch_period_calls":switch_period,"preparation_outside_dsp_seconds":preparation_seconds,
+                "profiling":cfg!(feature = "room-profile"), "stages":stages, "trace":trace_report,
+                "sample_rate":prepared.room.profile.sample_rate,"blocks":blocks,"call_frames":frames,"dsp_seconds":total,"audio_seconds":blocks as f64*deadline,
+                "worker_wall_budget_percent":100.*total/(blocks as f64*deadline),
+                "cpu_seconds":cpu,"cpu_audio_budget_percent":cpu.map(|v|100.*v/(blocks as f64*deadline)),
+                "rss_peak_bytes":(rss_peak!=0).then_some(rss_peak),"pose_update_hz":if moving{f64::from(prepared.room.profile.sample_rate)/frames as f64}else{0.},
+                "mean_ms":total*1000./blocks as f64,"p95_ms":elapsed[(blocks*95/100).min(blocks-1)]*1000.,
+                "hrir_hash":prepared.room.hrir.data.identity,"hrir_bank_bytes":prepared.room.hrir.storage_bytes(),
+                "memory_measurement":if cfg!(target_os="macos") {"process-peak-rusage"} else {"sampled-process-rss"},
+                "p99_ms":elapsed[(blocks*99/100).min(blocks-1)]*1000.,
+                "maximum_ms":elapsed[blocks-1]*1000.,"deadline_misses":elapsed.iter().filter(|v|**v>deadline).count(),"slowest_calls":slowest_calls,
+                "algorithm_fifo_frames":BLOCK,"reported_latency_frames":session.info().latency_frames,"experiment":experiment,"final_phase":session.info().phase,"peak":peak});
+            report["coordinate_mapping"] =
+                serde_json::json!(if automatic { "room" } else { "uniform" });
+            report["thread_scheduling"] = scheduling.clone();
+            println!("{report}");
+        }
+    }
+    Ok(())
+}
diff --git a/rust/crates/mradm-dsp/examples/room_support/room_replay.rs b/rust/crates/mradm-dsp/examples/room_support/room_replay.rs
new file mode 100644
index 0000000..f147847
--- /dev/null
+++ b/rust/crates/mradm-dsp/examples/room_support/room_replay.rs
@@ -0,0 +1,410 @@
+//! Release room-scoped numerical checkpoints. Resource bytes and event times
+//! are fixed; wall clocks and devices are deliberately absent from the input.
+use super::assets;
+#[cfg(feature = "room-gpu-experiment")]
+use super::gpu;
+use mradm_dsp::{
+    Result, geometry,
+    room::{
+        control::{RoomCommand, RoomDescription, State},
+        geometry::{self as room_geometry, Rotation},
+        hrir::HrirBank,
+        prepared::{PreparedRoom, ResponseWork},
+        quality::Quality,
+        resources::sha256,
+        screen::{RoomScreenGeometry, RoomScreens},
+        session::{Instance, PreparedSet, Session},
+    },
+};
+use std::{fs, io::Write, path::Path, sync::Arc};
+fn save(root: &Path, name: &str, samples: &[f32]) -> std::io::Result<serde_json::Value> {
+    let bytes: Vec<_> = samples.iter().flat_map(|v| v.to_le_bytes()).collect();
+    let mut out = fs::OpenOptions::new()
+        .write(true)
+        .create_new(true)
+        .open(root.join(name))?;
+    out.write_all(&bytes)?;
+    Ok(serde_json::json!({"sha256":sha256(&bytes),"samples":samples.len()}))
+}
+fn render(
+    prepared: Arc<PreparedSet>,
+    next: Arc<PreparedSet>,
+    chunks: &[usize],
+    screens: bool,
+    dense: bool,
+    head_motion: &str,
+    world_only: bool,
+) -> Result<Vec<f32>> {
+    const MATERIAL: usize = 96013;
+    let mut session = Session::new(prepared.clone(), 1.5, true, false)?;
+    let descriptions: Vec<_> = (0..32)
+        .map(|i| {
+            let v = geometry::portable_direction(i as f32 * 11.25, (i % 3) as f32 * 20. - 20.);
+            RoomDescription {
+                id: i as u64 + 1,
+                role: if i >= 30 { 2 } else { 0 },
+                screens: RoomScreens {
+                    enabled: u32::from(screens),
+                    reproduction: RoomScreenGeometry {
+                        width: 90.,
+                        ..RoomScreenGeometry::default()
+                    },
+                    ..RoomScreens::default()
+                },
+                position: [
+                    (-v[1] * 1.4) as f32,
+                    (v[0] * 1.4) as f32,
+                    (v[2] * 1.4) as f32,
+                ],
+                ..RoomDescription::default()
+            }
+        })
+        .collect();
+    session.configure(&descriptions)?;
+    let initial: Vec<_> = descriptions
+        .iter()
+        .enumerate()
+        .map(|(i, d)| RoomCommand {
+            element: i as u32,
+            state: State {
+                position: d.position,
+                head_locked: u32::from(i == 0 && !world_only),
+                screen_reference: u32::from(screens && i < 30),
+                diffuse: if i == 4 { 0.7 } else { 0. },
+                ..State::default()
+            },
+            ..RoomCommand::default()
+        })
+        .collect();
+    let mut moved = initial[1].state;
+    moved.position = [-2., 0.4, -0.2];
+    let mut quiet = initial[3].state;
+    quiet.gain = 0.23;
+    let mut relock = initial[2].state;
+    relock.head_locked = 1;
+    let mut events = vec![
+        (
+            731usize,
+            RoomCommand {
+                element: 1,
+                changed: 4,
+                duration: 1537,
+                state: moved,
+                ..RoomCommand::default()
+            },
+        ),
+        (
+            1789,
+            RoomCommand {
+                element: 3,
+                changed: 2,
+                duration: 913,
+                state: quiet,
+                ..RoomCommand::default()
+            },
+        ),
+        (
+            2901,
+            RoomCommand {
+                element: 2,
+                changed: 256,
+                state: relock,
+                ..RoomCommand::default()
+            },
+        ),
+    ];
+    if world_only {
+        events.retain(|(_, command)| command.changed & 256 == 0);
+    }
+    if dense {
+        // Dense replay: 30 non-LFE sources each ramp at a distinct sample offset.
+        // Keep the original head-lock, gain, pose, room-switch, removal and EOS schedule.
+        for block in 0..MATERIAL.div_ceil(512) {
+            for (source, command) in initial.iter().enumerate().take(30) {
+                let sample = block * 512 + (source * 131 + 17) % 512;
+                if sample >= MATERIAL {
+                    continue;
+                }
+                let direction = geometry::portable_direction(
+                    source as f32 * 11.25 + (block + 1) as f32 * 0.5,
+                    (source % 3) as f32 * 20. - 20.,
+                );
+                events.push((
+                    sample,
+                    RoomCommand {
+                        element: source as u32,
+                        changed: 4,
+                        duration: 512,
+                        state: State {
+                            position: [
+                                (-direction[1] * 1.4) as f32,
+                                (direction[0] * 1.4) as f32,
+                                (direction[2] * 1.4) as f32,
+                            ],
+                            ..command.state
+                        },
+                        ..RoomCommand::default()
+                    },
+                ));
+            }
+        }
+        events.sort_by_key(|event| event.0);
+    }
+    let mut candidate = Some(Box::new(Instance::new(next, 32)?));
+    let mut input = vec![[0.; 4096]; 32];
+    let mut block_output = vec![0.; 8192];
+    let mut commands = Vec::with_capacity(events.len());
+    let mut output = Vec::new();
+    let mut position = 0usize;
+    let mut sequence = 0;
+    let mut end = None;
+    let mut sources = 32;
+    loop {
+        if position == MATERIAL && end.is_none() {
+            session.end_input();
+            end = Some(MATERIAL + session.info().tail_frames as usize);
+        }
+        if end == Some(position) {
+            break;
+        }
+        if position == 32011 {
+            sources = 31;
+            session.configure(&descriptions[..sources])?;
+        }
+        if position == 7680 {
+            session.queue_room(candidate.take().unwrap(), 1)?;
+        }
+        if position.is_multiple_of(512) {
+            let step = (position / 512) as f32;
+            session.set_pose(match head_motion {
+                "slow" => [step * 0.25 - 35., step * 0.05 - 10., step * 0.02],
+                "fast" => [step * 4. - 170., step * 1., step * 0.3],
+                "wrap" => [
+                    ((179.85 + step * 0.1 + 180.) % 360.) - 180.,
+                    89.8,
+                    -30. + step * 0.04,
+                ],
+                _ => [step * 0.61 - 35., step * 0.12 - 10., step * 0.07],
+            })?;
+        }
+        let boundary = [
+            MATERIAL,
+            32011,
+            7680,
+            end.unwrap_or(MATERIAL),
+            (position / 512 + 1) * 512,
+        ]
+        .into_iter()
+        .filter(|v| *v > position)
+        .min()
+        .unwrap();
+        let count = chunks[sequence % chunks.len()]
+            .min(4096)
+            .min(boundary - position);
+        sequence += 1;
+        for (source, plane) in input.iter_mut().enumerate() {
+            for (i, value) in plane[..count].iter_mut().enumerate() {
+                let word = ((position + i) * 3943 + source * 7817) % 65521;
+                *value = if position < MATERIAL {
+                    (word as f32 - 32760.) / 16777216.
+                } else {
+                    0.
+                };
+            }
+        }
+        commands.clear();
+        for (sample, command) in events.iter().copied() {
+            if sample >= position && sample < position + count {
+                let mut c = command;
+                c.offset = (sample - position) as u32;
+                commands.push(c);
+            }
+        }
+        session.process(
+            count,
+            input[..sources].iter().map(|p| Some(&p[..count])),
+            if position == 0 { &initial } else { &[] },
+            &commands,
+            &mut block_output[..count * 2],
+        )?;
+        output.extend_from_slice(&block_output[..count * 2]);
+        position += count;
+        let _retired = session.take_retired();
+    }
+    Ok(output)
+}
+pub fn run() -> std::result::Result<(), Box<dyn std::error::Error>> {
+    if cfg!(debug_assertions) {
+        return Err("Use Release for numerical acceptance".into());
+    }
+    let mut args: Vec<_> = std::env::args().collect();
+    #[cfg(feature = "room-gpu-experiment")]
+    let gpu = gpu::Options::parse(&mut args)?;
+    let hrir_path = if let Some(index) = args.iter().position(|v| v == "--hrir") {
+        let path = args
+            .get(index + 1)
+            .ok_or("--hrir needs a resource path")?
+            .clone();
+        args.drain(index..index + 2);
+        Some(std::path::PathBuf::from(path))
+    } else {
+        None
+    };
+    let quality = if let Some(index) = args.iter().position(|v| v == "--quality") {
+        let value = args
+            .get(index + 1)
+            .ok_or("--quality needs exact or realtime")?
+            .parse::<Quality>()?;
+        args.drain(index..index + 2);
+        value
+    } else {
+        Quality::Exact
+    };
+    let head_motion = if let Some(index) = args.iter().position(|v| v == "--head-motion") {
+        let value = args
+            .get(index + 1)
+            .ok_or("--head-motion needs standard, slow, fast or wrap")?
+            .clone();
+        if !["standard", "slow", "fast", "wrap"].contains(&value.as_str()) {
+            return Err("--head-motion needs standard, slow, fast or wrap".into());
+        }
+        args.drain(index..index + 2);
+        value
+    } else {
+        "standard".to_owned()
+    };
+    let screens = args.iter().any(|v| v == "--screens");
+    let dense = args.iter().any(|v| v == "--dense");
+    let world_only = args.iter().any(|v| v == "--world-only");
+    args.retain(|v| v != "--screens" && v != "--dense" && v != "--world-only");
+    if args.len() != 3 {
+        return Err("usage: room_replay ROOM_JSON NEW_OUTPUT_DIRECTORY [--hrir SOFA_OR_COLLECTION] [--screens] [--dense] [--world-only] [--quality exact|realtime] [--head-motion standard|slow|fast|wrap]".into());
+    }
+    let file = Path::new(&args[1]);
+    let root = file.parent().ok_or("missing parent")?;
+    let out = Path::new(&args[2]);
+    fs::create_dir(out)?;
+    let profile = Arc::new(assets::profile(file)?);
+    let selected = hrir_path.unwrap_or_else(|| root.join(&profile.default_hrir));
+    let hrir = Arc::new(assets::hrir_at_rate(&selected, profile.sample_rate)?);
+    let (length, _, _) = PreparedRoom::required_fft(&profile, &hrir)?;
+    let bank = Arc::new(HrirBank::with_policy(hrir, length, quality.fft())?);
+    let room = Arc::new(PreparedRoom::with_quality(
+        profile.clone(),
+        bank.clone(),
+        quality,
+    )?);
+    let prepared = Arc::new(PreparedSet::new(room.clone())?);
+    let mut changed = (*profile).clone();
+    changed.identity.push_str("-replay");
+    changed.absorption = [[0.90; 8]; 6];
+    changed.late_energy *= 0.8;
+    changed.dimensions[0] += 0.5;
+    changed.listener[0] += 0.25;
+    changed.dimensions[1] += 0.2;
+    changed.listener[1] += 0.1;
+    let next = Arc::new(PreparedSet::new(Arc::new(PreparedRoom::with_quality(
+        Arc::new(changed),
+        bank,
+        quality,
+    )?))?);
+    #[cfg(feature = "room-gpu-experiment")]
+    let (prepared, next) = (gpu.prepare(prepared)?, gpu.prepare(next)?);
+    let mut work = ResponseWork::new(&room)?;
+    let mut query = vec![0.; room.hrir.data.output_taps * 2];
+    let mut manifest = serde_json::json!({"schema":"mradm.room-replay","version":1,
+        "scenario":"controls-distance-geometry-switch-v1",
+        "room_hash":profile.identity,"hrir_hash":room.hrir.data.identity,"prepared":room.fingerprint(),
+        "lfe":prepared.lfe.fingerprint(),"latency_frames":256,"tail_frames":prepared.tail_frames(),"files":{}});
+    if quality != Quality::Exact {
+        manifest["processing_policy"] = quality.policy().into();
+    }
+    #[cfg(feature = "room-gpu-experiment")]
+    if !gpu.report().is_null() {
+        manifest["experiment"] = gpu.report();
+    }
+    for (index, [az, el, r]) in [
+        [0., 0., 0.75],
+        [0., 0., 1.5],
+        [0., 0., 3.],
+        [179.999, 0., 2.1],
+        [-179.999, 0., 2.1],
+        [0., 89.999, 1.85],
+        [0., -89.999, 1.05],
+        [91.3, -31.1, 2.1],
+    ]
+    .into_iter()
+    .enumerate()
+    {
+        let direction = geometry::portable_direction(az as f32, el as f32);
+        let mut face = usize::MAX;
+        work.hrir(&room, direction, &mut face, &mut query)?;
+        let name = format!("hrir-{index}.f32");
+        manifest["files"][&name] = save(out, &name, &query)?;
+        let position = room_geometry::position(
+            &profile,
+            [
+                (-direction[1] * r) as f32,
+                (direction[0] * r) as f32,
+                (direction[2] * r) as f32,
+            ],
+            1.,
+            [1., 0., 0.],
+        )?;
+        work.build(&room, position, &Rotation::new([13., -7., 11.])?)?;
+        let name = format!("branches-{index}.f32");
+        manifest["files"][&name] = save(out, &name, &work.impulse)?;
+    }
+    if screens {
+        manifest["scenario"] = "controls-screen-distance-geometry-switch-v1".into();
+    }
+    if dense {
+        manifest["dense_source_ramps"] = true.into();
+    }
+    if head_motion != "standard" {
+        manifest["head_motion"] = head_motion.clone().into();
+    }
+    if world_only {
+        // Separate workload identity; never compare this to a head-locked replay.
+        let scenario = manifest["scenario"].as_str().unwrap().to_owned();
+        manifest["scenario"] = format!("{scenario}-world-only").into();
+        manifest["world_only"] = true.into();
+    }
+    let canonical = render(
+        prepared.clone(),
+        next.clone(),
+        if world_only { &[512] } else { &[256] },
+        screens,
+        dense,
+        &head_motion,
+        world_only,
+    )?;
+    let fragmented = render(
+        prepared,
+        next,
+        &[1, 173, 733, 4096, 19, 257],
+        screens,
+        dense,
+        &head_motion,
+        world_only,
+    )?;
+    if canonical
+        .iter()
+        .map(|v| v.to_bits())
+        .ne(fragmented.iter().map(|v| v.to_bits()))
+    {
+        return Err("Fragmented replay differs from canonical PCM".into());
+    }
+    manifest["files"]["session.f32"] = save(out, "session.f32", &canonical)?;
+    manifest["frames"] = (canonical.len() / 2).into();
+    fs::write(
+        out.join("manifest.json"),
+        serde_json::to_vec_pretty(&manifest)?,
+    )?;
+    println!(
+        "{}",
+        serde_json::json!({"output":out,"frames":canonical.len()/2,"fragmented_identical":true,
+        "pcm_sha256":manifest["files"]["session.f32"]["sha256"],"os":std::env::consts::OS,"arch":std::env::consts::ARCH})
+    );
+    Ok(())
+}
diff --git a/rust/crates/mradm-dsp/tests/room_cuda_resources.rs b/rust/crates/mradm-dsp/tests/room_cuda_resources.rs
new file mode 100644
index 0000000..2d63b55
--- /dev/null
+++ b/rust/crates/mradm-dsp/tests/room_cuda_resources.rs
@@ -0,0 +1,55 @@
+#![cfg(feature = "room-gpu-experiment")]
+use mradm_dsp::room::{hrir::PHASES, quality::Quality, resources::sha256};
+#[path = "common/room_fixture.rs"]
+#[allow(dead_code)]
+mod common;
+
+#[test]
+fn resident_upload_windows_preserve_all_prepared_spectral_bits() {
+    for rate in [48000, 96000] {
+        let prepared = common::fixture_at_rate(Quality::Realtime, rate);
+        let bank = &prepared.room.hrir;
+        let bins = bank.fft_length / 2 + 1;
+        let rows = bank.data.directions.len() * 2;
+        let fingerprint = bank.fingerprint();
+        let layers = bank.data.collection.as_ref().unwrap().layers.len();
+        for layer in 0..layers {
+            let mut values = vec![0.; rows * bins * 2];
+            for first in (0..rows).step_by(5) {
+                let count = 5.min(rows - first);
+                bank.gpu_copy_rows(
+                    layer * rows + first,
+                    &mut values[first * bins * 2..(first + count) * bins * 2],
+                )
+                .unwrap();
+            }
+            let bytes: Vec<_> = values.iter().flat_map(|v| v.to_le_bytes()).collect();
+            assert_eq!(
+                sha256(&bytes),
+                fingerprint["distance_layers"]["spectra"][layer]
+                    .as_str()
+                    .unwrap()
+            );
+        }
+        let mut values = vec![0.; (PHASES + 1) * bins * 2];
+        for first in (0..=PHASES).step_by(7) {
+            let count = 7.min(PHASES + 1 - first);
+            bank.gpu_copy_fractions(
+                first,
+                &mut values[first * bins * 2..(first + count) * bins * 2],
+            )
+            .unwrap();
+        }
+        let bytes: Vec<_> = values.iter().flat_map(|v| v.to_le_bytes()).collect();
+        assert_eq!(sha256(&bytes), fingerprint["fractional"].as_str().unwrap());
+        assert!(
+            bank.gpu_copy_rows(layers * rows, &mut values[..bins * 2])
+                .is_err()
+        );
+        assert!(bank.gpu_copy_rows(0, &mut values[..1]).is_err());
+        assert!(
+            bank.gpu_copy_fractions(PHASES + 1, &mut values[..bins * 2])
+                .is_err()
+        );
+    }
+}
diff --git a/rust/crates/mradm-ffi/src/room_cuda_selection.rs b/rust/crates/mradm-ffi/src/room_cuda_selection.rs
