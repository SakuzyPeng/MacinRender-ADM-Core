+use mradm_dsp::room::session::PreparedSet;
+use std::{path::PathBuf, sync::Arc};
+pub struct Options {
+    enabled: bool,
+    library: Option<PathBuf>,
+}
+impl Options {
+    pub fn parse(args: &mut Vec<String>) -> std::result::Result<Self, Box<dyn std::error::Error>> {
+        let mut enabled = args.iter().any(|v| v == "--cuda");
+        args.retain(|v| v != "--cuda");
+        let library = if let Some(index) = args.iter().position(|v| v == "--cuda-library") {
+            let value = args
+                .get(index + 1)
+                .ok_or("--cuda-library needs a path")?
+                .into();
+            args.drain(index..index + 2);
+            enabled = true;
+            Some(value)
+        } else {
+            None
+        };
+        Ok(Self { enabled, library })
+    }
+    pub fn prepare(
+        &self,
+        prepared: Arc<PreparedSet>,
+    ) -> std::result::Result<Arc<PreparedSet>, Box<dyn std::error::Error>> {
+        if self.enabled {
+            Ok(mradm_room_cuda::bind(prepared, self.library.as_deref())?.0)
+        } else {
+            Ok(prepared)
+        }
+    }
+    pub fn report(&self) -> serde_json::Value {
+        if self.enabled {
+            serde_json::json!({"kind":"room-cuda-session","control":"production Session","finite_fade":true,"cpu_reference":false,"binding":"prepared-memory","eq_stagger_frames":256})
+        } else {
+            serde_json::Value::Null
+        }
+    }
+}
diff --git a/rust/crates/mradm-room-cuda/src/lib.rs b/rust/crates/mradm-room-cuda/src/lib.rs
new file mode 100644
index 0000000..591a8ca
--- /dev/null
+++ b/rust/crates/mradm-room-cuda/src/lib.rs
@@ -0,0 +1,52 @@
+//! Optional native ROOM boundary. Resource preparation is synchronous; the DSP
+//! library owns all clocks and never links CUDA or performs file I/O.
+#[cfg(not(windows))]
+use mradm_dsp::Error;
+use mradm_dsp::{Result, room::session::PreparedSet};
+use std::{path::Path, sync::Arc};
+
+#[cfg(windows)]
+mod native;
+#[cfg(windows)]
+pub use native::NativeFactory;
+
+pub fn bind(
+    prepared: Arc<PreparedSet>,
+    library: Option<&Path>,
+) -> Result<(Arc<PreparedSet>, serde_json::Value)> {
+    #[cfg(windows)]
+    {
+        use mradm_dsp::room::{
+            gpu_experiment::{Backend, Factory, LateBackend},
+            prepared::PreparedRoom,
+        };
+        struct CachedFactory {
+            native: Arc<NativeFactory>,
+            // Keep the CPU weak-cache entry alive without duplicating its data.
+            _prepared: Arc<PreparedSet>,
+        }
+        impl Factory for CachedFactory {
+            fn create(&self, room: Arc<PreparedRoom>) -> Result<Box<dyn Backend>> {
+                self.native.create(room)
+            }
+            fn create_late(&self, room: Arc<PreparedRoom>) -> Result<Option<Box<dyn LateBackend>>> {
+                self.native.create_late(room)
+            }
+        }
+        let native = NativeFactory::new(prepared.room.clone(), library)?;
+        let metadata = native.metadata()?;
+        let factory = Arc::new(CachedFactory {
+            native,
+            _prepared: prepared.clone(),
+        });
+        let bound = prepared
+            .with_gpu_experiment(factory)?
+            .with_gpu_tuning(true, 0)?;
+        Ok((Arc::new(bound), metadata))
+    }
+    #[cfg(not(windows))]
+    {
+        let _ = (prepared, library);
+        Err(Error::Unsupported("ROOM CUDA is available only on Windows"))
+    }
+}
diff --git a/rust/crates/mradm-room-cuda/src/native.rs b/rust/crates/mradm-room-cuda/src/native.rs
new file mode 100644
index 0000000..0409737
--- /dev/null
+++ b/rust/crates/mradm-room-cuda/src/native.rs
@@ -0,0 +1,573 @@
+//! Unsafe calls are confined to this private, versioned native plugin boundary.
+use mradm_dsp::{
+    Complex32, Error, Result,
+    room::{
+        gpu_experiment::{Backend, Factory, Frame, Job, LateBackend, Range, Task, Update},
+        hrir::{HrirBank, PHASES},
+        prepared::PreparedRoom,
+        quality::Quality,
+    },
+};
+use std::{
+    collections::BTreeMap,
+    ffi::{CStr, OsString, c_void},
+    os::windows::ffi::{OsStrExt, OsStringExt},
+    path::{Path, PathBuf},
+    sync::{Arc, Mutex, OnceLock, Weak},
+};
+
+const SOURCE: &str = include_str!(concat!(
+    env!("CARGO_MANIFEST_DIR"),
+    "/../../../scripts/research/room_gpu/session_kernels.cu"
+));
+const ABI: u32 = 1;
+#[link(name = "kernel32")]
+unsafe extern "system" {
+    fn LoadLibraryExW(path: *const u16, file: *mut c_void, flags: u32) -> *mut c_void;
+    fn GetProcAddress(module: *mut c_void, name: *const u8) -> *mut c_void;
+    fn FreeLibrary(module: *mut c_void) -> i32;
+    fn GetModuleHandleExW(flags: u32, address: *const u16, module: *mut *mut c_void) -> i32;
+    fn GetModuleFileNameW(module: *mut c_void, path: *mut u16, size: u32) -> u32;
+    fn AddDllDirectory(path: *const u16) -> *mut c_void;
+    fn RemoveDllDirectory(cookie: *mut c_void) -> i32;
+}
+fn module_anchor() {}
+fn default_library() -> Result<PathBuf> {
+    let mut module = std::ptr::null_mut();
+    if unsafe {
+        GetModuleHandleExW(
+            0x4 | 0x2,
+            module_anchor as *const () as *const u16,
+            &mut module,
+        )
+    } == 0
+    {
+        return Err(Error::Io("Cannot locate the ROOM CUDA host module"));
+    }
+    let mut path = vec![0u16; 32768];
+    let used = unsafe { GetModuleFileNameW(module, path.as_mut_ptr(), path.len() as u32) } as usize;
+    if used == 0 || used >= path.len() {
+        return Err(Error::Io("Cannot locate the ROOM CUDA host directory"));
+    }
+    let path = PathBuf::from(OsString::from_wide(&path[..used]));
+    Ok(path
+        .parent()
+        .ok_or(Error::Io("Missing ROOM CUDA host directory"))?
+        .join("mradm_room_cuda.dll"))
+}
+struct ModuleHandle(*mut c_void);
+impl Drop for ModuleHandle {
+    fn drop(&mut self) {
+        unsafe {
+            FreeLibrary(self.0);
+        }
+    }
+}
+struct Directory(*mut c_void);
+impl Drop for Directory {
+    fn drop(&mut self) {
+        unsafe {
+            RemoveDllDirectory(self.0);
+        }
+    }
+}
+
+#[repr(C)]
+struct Params {
+    rate: u32,
+    fft: u32,
+    taps: u32,
+    stride: u32,
+    buckets: u32,
+    rows: u32,
+    images: u32,
+    history_parts: u32,
+    materials: *const f32,
+    material_floats: usize,
+    propagation: *const f32,
+    propagation_floats: usize,
+}
+#[repr(C)]
+struct NativeFrame {
+    active: u32,
+    reset: u32,
+    heads: [u32; 2],
+    frequency: *const f32,
+    jobs: *const Job,
+    job_count: usize,
+    ranges: *const Range,
+    range_count: usize,
+    updates: *const Update,
+    update_count: usize,
+    tasks: *const Task,
+    task_count: usize,
+}
+#[repr(C)]
+struct BankDesc {
+    abi: u32,
+    size: u32,
+    rate: u32,
+    fft: u32,
+    rows: u32,
+}
+#[derive(Default, Debug)]
+#[repr(C)]
+pub struct Stats {
+    pub banks: u64,
+    pub engines: u64,
+    pub late_engines: u64,
+    pub device_bytes: u64,
+    pub pinned_bytes: u64,
+}
+type Destroy = unsafe extern "C" fn(*mut c_void);
+type BankCreate = unsafe extern "C" fn(*const BankDesc, *const u8, usize) -> *mut c_void;
+type BankUpload = unsafe extern "C" fn(*mut c_void, u32, usize, *const f32, usize) -> i32;
+type BankSeal = unsafe extern "C" fn(*mut c_void) -> i32;
+type BankDevice = unsafe extern "C" fn(*mut c_void) -> *const std::ffi::c_char;
+type StatsFn = unsafe extern "C" fn(*mut Stats) -> i32;
+type Create = unsafe extern "C" fn(*mut c_void, *const Params) -> *mut c_void;
+type Begin = unsafe extern "C" fn(*mut c_void, u32) -> i32;
+type Voice = unsafe extern "C" fn(*mut c_void, u32, *const NativeFrame) -> i32;
+type Submit = unsafe extern "C" fn(*mut c_void) -> i32;
+type Finish = unsafe extern "C" fn(*mut c_void, *mut f32, usize) -> i32;
+type Message = unsafe extern "C" fn() -> *const std::ffi::c_char;
+type LateCreate = unsafe extern "C" fn(*mut c_void, u32, u32, *const f32, usize) -> *mut c_void;
+type LateSubmit = unsafe extern "C" fn(*mut c_void, *const f32, usize, u32) -> i32;
+struct Library {
+    _module: ModuleHandle,
+    _directory: Directory,
+    bank_create: BankCreate,
+    bank_upload: BankUpload,
+    bank_seal: BankSeal,
+    bank_destroy: Destroy,
+    bank_device: BankDevice,
+    stats: StatsFn,
+    create: Create,
+    destroy: Destroy,
+    begin: Begin,
+    voice: Voice,
+    submit: Submit,
+    finish: Finish,
+    message: Message,
+    late_create: LateCreate,
+    late_destroy: Destroy,
+    late_submit: LateSubmit,
+    late_finish: Finish,
+}
+// Module ownership and immutable function pointers may cross preparation/worker threads.
+unsafe impl Send for Library {}
+unsafe impl Sync for Library {}
+impl Library {
+    fn load(path: &Path) -> Result<Arc<Self>> {
+        let parent: Vec<_> = path
+            .parent()
+            .ok_or(Error::Io("Missing ROOM CUDA runtime directory"))?
+            .as_os_str()
+            .encode_wide()
+            .chain(Some(0))
+            .collect();
+        let directory = Directory(unsafe { AddDllDirectory(parent.as_ptr()) });
+        if directory.0.is_null() {
+            return Err(Error::Io("Cannot register ROOM CUDA runtime directory"));
+        }
+        let wide: Vec<_> = path.as_os_str().encode_wide().chain(Some(0)).collect();
+        let module = ModuleHandle(unsafe {
+            LoadLibraryExW(wide.as_ptr(), std::ptr::null_mut(), 0x100 | 0x1000)
+        });
+        if module.0.is_null() {
+            return Err(Error::Unsupported(
+                "Optional ROOM CUDA runtime or its dependencies are unavailable",
+            ));
+        }
+        let symbol = |name: &[u8]| -> Result<*mut c_void> {
+            let pointer = unsafe { GetProcAddress(module.0, name.as_ptr()) };
+            if pointer.is_null() {
+                Err(Error::Unsupported("Incompatible ROOM CUDA runtime"))
+            } else {
+                Ok(pointer)
+            }
+        };
+        macro_rules! get {
+            ($name:literal,$ty:ty) => {
+                unsafe {
+                    std::mem::transmute::<*mut c_void, $ty>(symbol(
+                        concat!($name, "\0").as_bytes(),
+                    )?)
+                }
+            };
+        }
+        let version = get!("mradm_room_cuda_abi", unsafe extern "C" fn() -> u32);
+        if unsafe { version() } != ABI {
+            return Err(Error::Unsupported("Incompatible ROOM CUDA ABI"));
+        }
+        let value = Self {
+            bank_create: get!("mradm_room_cuda_bank_create", BankCreate),
+            bank_upload: get!("mradm_room_cuda_bank_upload", BankUpload),
+            bank_seal: get!("mradm_room_cuda_bank_seal", BankSeal),
+            bank_destroy: get!("mradm_room_cuda_bank_destroy", Destroy),
+            bank_device: get!("mradm_room_cuda_bank_device", BankDevice),
+            stats: get!("mradm_room_cuda_stats", StatsFn),
+            create: get!("mradm_room_cuda_session_create", Create),
+            destroy: get!("mradm_room_cuda_session_destroy", Destroy),
+            begin: get!("mradm_room_cuda_session_begin", Begin),
+            voice: get!("mradm_room_cuda_session_voice", Voice),
+            submit: get!("mradm_room_cuda_session_submit", Submit),
+            finish: get!("mradm_room_cuda_session_finish", Finish),
+            message: get!("mradm_room_cuda_session_error", Message),
+            late_create: get!("mradm_room_cuda_late_create", LateCreate),
+            late_destroy: get!("mradm_room_cuda_late_destroy", Destroy),
+            late_submit: get!("mradm_room_cuda_late_submit", LateSubmit),
+            late_finish: get!("mradm_room_cuda_late_finish", Finish),
+            _module: module,
+            _directory: directory,
+        };
+        Ok(Arc::new(value))
+    }
+    fn check(&self, status: i32) -> Result<()> {
+        if status == 0 {
+            return Ok(());
+        }
+        let message = unsafe { (self.message)() };
+        if !message.is_null() {
+            eprintln!(
+                "ROOM CUDA: {}",
+                unsafe { CStr::from_ptr(message) }.to_string_lossy()
+            );
+        }
+        Err(Error::RenderFailed(
+            "ROOM CUDA operation failed; recreate the session after correcting the device/runtime error",
+        ))
+    }
+}
+struct Bank {
+    library: Arc<Library>,
+    handle: *mut c_void,
+    cpu: Arc<HrirBank>,
+}
+// Upload is complete before publication. Engines only read these shared tables.
+unsafe impl Send for Bank {}
+unsafe impl Sync for Bank {}
+impl Drop for Bank {
+    fn drop(&mut self) {
+        unsafe {
+            (self.library.bank_destroy)(self.handle);
+        }
+    }
+}
+impl Bank {
+    fn new(cpu: Arc<HrirBank>, path: &Path) -> Result<Self> {
+        let library = Library::load(path)?;
+        let layers = cpu.data.collection.as_ref().map_or(1, |c| c.layers.len());
+        let rows = layers
+            .checked_mul(cpu.data.directions.len())
+            .and_then(|n| n.checked_mul(2))
+            .ok_or(Error::Unsupported("ROOM CUDA bank is too large"))?;
+        if rows > 65536 {
+            return Err(Error::Unsupported("ROOM CUDA bank is too large"));
+        }
+        let desc = BankDesc {
+            abi: ABI,
+            size: size_of::<BankDesc>() as u32,
+            rate: cpu.data.sample_rate,
+            fft: cpu.fft_length as u32,
+            rows: rows as u32,
+        };
+        let handle = unsafe { (library.bank_create)(&desc, SOURCE.as_ptr(), SOURCE.len()) };
+        if handle.is_null() {
+            library.check(1)?;
+        }
+        let bank = Self {
+            library,
+            handle,
+            cpu,
+        };
+        let bins = bank.cpu.fft_length / 2 + 1;
+        let mut buffer = vec![0f32; 64 * bins * 2];
+        for (table, total) in [(0, rows), (1, PHASES + 1)] {
+            for first in (0..total).step_by(64) {
+                let count = 64.min(total - first);
+                let row = &mut buffer[..count * bins * 2];
+                if table == 0 {
+                    bank.cpu.gpu_copy_rows(first, row)?;
+                } else {
+                    bank.cpu.gpu_copy_fractions(first, row)?;
+                }
+                bank.library.check(unsafe {
+                    (bank.library.bank_upload)(
+                        handle,
+                        table,
+                        first * bins * 2,
+                        row.as_ptr(),
+                        row.len(),
+                    )
+                })?;
+            }
+        }
+        let phases = &mut buffer[..bank.cpu.fft_length * 2];
+        for (bin, out) in phases.as_chunks_mut::<2>().0.iter_mut().enumerate() {
+            let v = bank.cpu.integer_phase(1, bin);
+            out.copy_from_slice(&[v.re, v.im]);
+        }
+        bank.library.check(unsafe {
+            (bank.library.bank_upload)(handle, 2, 0, phases.as_ptr(), phases.len())
+        })?;
+        bank.library
+            .check(unsafe { (bank.library.bank_seal)(handle) })?;
+        Ok(bank)
+    }
+}
+type Entry = OnceLock<Result<Bank>>;
+fn copy_error(error: &Error) -> Error {
+    match error {
+        Error::InvalidArgument(s) => Error::InvalidArgument(s),
+        Error::Unsupported(s) => Error::Unsupported(s),
+        Error::RenderFailed(s) => Error::RenderFailed(s),
+        Error::Io(s) => Error::Io(s),
+    }
+}
+pub struct NativeFactory {
+    entry: Arc<Entry>,
+}
+impl NativeFactory {
+    pub fn new(room: Arc<PreparedRoom>, library: Option<&Path>) -> Result<Arc<Self>> {
+        if room.quality != Quality::Realtime
+            || room.profile.sample_rate != 96000
+            || room.fft_length != 4096
+            || room.early_channels() != 2
+        {
+            return Err(Error::Unsupported(
+                "This room/HRIR configuration is not supported by the optional Windows CUDA backend",
+            ));
+        }
+        let path = library
+            .map(Path::to_path_buf)
+            .map_or_else(default_library, Ok)?;
+        let path = path
+            .canonicalize()
+            .map_err(|_| Error::Unsupported("Optional ROOM CUDA runtime is unavailable"))?;
+        type Cache = BTreeMap<(PathBuf, usize), Weak<Entry>>;
+        static CACHE: OnceLock<Mutex<Cache>> = OnceLock::new();
+        let key = (path.clone(), Arc::as_ptr(&room.hrir) as usize);
+        let entry = {
+            let mut entries = CACHE
+                .get_or_init(Default::default)
+                .lock()
+                .map_err(|_| Error::RenderFailed("ROOM CUDA cache failed"))?;
+            entries.retain(|_, v| v.strong_count() != 0);
+            if let Some(value) = entries.get(&key).and_then(Weak::upgrade) {
+                value
+            } else {
+                let value = Arc::new(OnceLock::new());
+                entries.insert(key, Arc::downgrade(&value));
+                value
+            }
+        };
+        // Per-key single-flight initialization never holds the global cache lock.
+        entry
+            .get_or_init(|| Bank::new(room.hrir.clone(), &path))
+            .as_ref()
+            .map_err(copy_error)?;
+        Ok(Arc::new(Self { entry }))
+    }
+    fn bank(&self) -> &Bank {
+        self.entry.get().unwrap().as_ref().unwrap()
+    }
+    pub fn stats(&self) -> Result<Stats> {
+        let mut value = Stats::default();
+        self.bank()
+            .library
+            .check(unsafe { (self.bank().library.stats)(&mut value) })?;
+        Ok(value)
+    }
+    pub fn metadata(&self) -> Result<serde_json::Value> {
+        let bank = self.bank();
+        let name = unsafe { (bank.library.bank_device)(bank.handle) };
+        if name.is_null() {
+            bank.library.check(1)?;
+        }
+        Ok(
+            serde_json::json!({"kind":"cuda","abi":ABI,"device":unsafe { CStr::from_ptr(name) }.to_string_lossy(),"binding":"prepared-memory","kernel_sha256":mradm_dsp::room::resources::sha256(SOURCE.as_bytes()),"eq_stagger_frames":256,"maximum_sources":32}),
+        )
+    }
+}
+
+impl Factory for NativeFactory {
+    fn create(&self, room: Arc<PreparedRoom>) -> Result<Box<dyn Backend>> {
+        let bank = self.bank();
+        if !Arc::ptr_eq(&room.hrir, &bank.cpu) || room.quality != Quality::Realtime {
+            return Err(Error::InvalidArgument(
+                "ROOM CUDA prepared resource binding changed",
+            ));
+        }
+        let materials: Vec<_> = room
+            .gpu_material()
+            .iter()
+            .flat_map(|v| [v.re, v.im])
+            .collect();
+        let bins = room.fft_length / 2 + 1;
+        let mut propagation = Vec::with_capacity((PHASES + 1) * bins * 2);
+        for phase in 0..=PHASES {
+            propagation.extend(
+                room.gpu_propagation_row(phase)?
+                    .iter()
+                    .flat_map(|v| [v.re, v.im]),
+            );
+        }
+        let layers = room
+            .hrir
+            .data
+            .collection
+            .as_ref()
+            .map_or(1, |c| c.layers.len());
+        let params = Params {
+            rate: room.profile.sample_rate,
+            fft: room.fft_length as u32,
+            taps: room.short_taps as u32,
+            stride: room.path_bucket_stride as u32,
+            buckets: room.short_taps.div_ceil(room.path_bucket_stride) as u32,
+            rows: (layers * room.hrir.data.directions.len() * 2) as u32,
+            images: room.images.len() as u32,
+            history_parts: room.short_taps.max(room.send_taps).div_ceil(256) as u32,
+            materials: materials.as_ptr(),
+            material_floats: materials.len(),
+            propagation: propagation.as_ptr(),
+            propagation_floats: propagation.len(),
+        };
+        let context = unsafe { (bank.library.create)(bank.handle, &params) };
+        if context.is_null() {
+            bank.library.check(1)?;
+        }
+        Ok(Box::new(Native {
+            _entry: self.entry.clone(),
+            library: bank.library.clone(),
+            context,
+        }))
+    }
+    fn create_late(&self, room: Arc<PreparedRoom>) -> Result<Option<Box<dyn LateBackend>>> {
+        let bank = self.bank();
+        if !Arc::ptr_eq(&room.hrir, &bank.cpu) {
+            return Err(Error::InvalidArgument(
+                "ROOM CUDA late resource binding changed",
+            ));
+        }
+        let Some(first) = room.late[0].gpu_tail() else {
+            return Ok(None);
+        };
+        let parts = first.len() / 2049;
+        let mut filters = Vec::with_capacity(first.len() * room.late.len() * 2);
+        for row in &room.late {
+            let values = row
+                .gpu_tail()
+                .ok_or(Error::Unsupported("Inconsistent ROOM CUDA late shape"))?;
+            if row.channels != 1 || values.len() != first.len() {
+                return Err(Error::Unsupported("Inconsistent ROOM CUDA late shape"));
+            }
+            filters.extend(values.iter().flat_map(|v| [v.re, v.im]));
+        }
+        let context = unsafe {
+            (bank.library.late_create)(
+                bank.handle,
+                parts as u32,
+                room.late.len() as u32,
+                filters.as_ptr(),
+                filters.len(),
+            )
+        };
+        if context.is_null() {
+            bank.library.check(1)?;
+        }
+        Ok(Some(Box::new(NativeLate {
+            _entry: self.entry.clone(),
+            library: bank.library.clone(),
+            context,
+        })))
+    }
+}
+struct NativeLate {
+    _entry: Arc<Entry>,
+    library: Arc<Library>,
+    context: *mut c_void,
+}
+// The owning WorldTail serializes submissions and consumes each result before reuse.
+unsafe impl Send for NativeLate {}
+impl Drop for NativeLate {
+    fn drop(&mut self) {
+        unsafe {
+            (self.library.late_destroy)(self.context);
+        }
+    }
+}
+impl LateBackend for NativeLate {
+    fn submit(&mut self, frequency: &[Complex32], reset: bool) -> Result<()> {
+        if frequency.len() != 2049 {
+            return Err(Error::InvalidArgument("Invalid GPU late input"));
+        }
+        let mut row = [0.; 4098];
+        for (out, value) in row.as_chunks_mut::<2>().0.iter_mut().zip(frequency) {
+            out.copy_from_slice(&[value.re, value.im]);
+        }
+        self.library.check(unsafe {
+            (self.library.late_submit)(self.context, row.as_ptr(), row.len(), u32::from(reset))
+        })
+    }
+    fn finish(&mut self, output: &mut [f32]) -> Result<()> {
+        self.library.check(unsafe {
+            (self.library.late_finish)(self.context, output.as_mut_ptr(), output.len())
+        })
+    }
+}
+struct Native {
+    _entry: Arc<Entry>,
+    library: Arc<Library>,
+    context: *mut c_void,
+}
+// The Session owns this engine and serializes begin/submit/finish. The DLL
+// binds the CUDA primary context when used on the persistent worker thread.
+unsafe impl Send for Native {}
+impl Drop for Native {
+    fn drop(&mut self) {
+        unsafe {
+            (self.library.destroy)(self.context);
+        }
+    }
+}
+impl Backend for Native {
+    fn begin(&mut self, count: usize) -> Result<()> {
+        self.library
+            .check(unsafe { (self.library.begin)(self.context, count as u32) })
+    }
+    fn voice(&mut self, index: usize, frame: &Frame) -> Result<()> {
+        let mut updates = [Update::default(); 32];
+        if frame.requests.len() > updates.len() {
+            return Err(Error::Unsupported("GPU update capacity exceeded"));
+        }
+        for (out, request) in updates.iter_mut().zip(&frame.requests) {
+            *out = request.update;
+        }
+        let f = NativeFrame {
+            active: u32::from(frame.active),
+            reset: u32::from(frame.reset),
+            heads: frame.heads,
+            frequency: frame.frequency.as_ptr(),
+            jobs: frame.jobs.as_ptr(),
+            job_count: frame.jobs.len(),
+            ranges: frame.ranges.as_ptr(),
+            range_count: frame.ranges.len(),
+            updates: updates.as_ptr(),
+            update_count: frame.requests.len(),
+            tasks: frame.tasks.as_ptr(),
+            task_count: frame.tasks.len(),
+        };
+        self.library
+            .check(unsafe { (self.library.voice)(self.context, index as u32, &f) })
+    }
+    fn submit(&mut self) -> Result<()> {
+        self.library
+            .check(unsafe { (self.library.submit)(self.context) })
+    }
+    fn finish(&mut self, output: &mut [f32]) -> Result<()> {
+        self.library.check(unsafe {
+            (self.library.finish)(self.context, output.as_mut_ptr(), output.len())
+        })
+    }
+}
diff --git a/src/adm_render_room/cuda/backend.cpp b/src/adm_render_room/cuda/backend.cpp
new file mode 100644
index 0000000..9f5e9d7
--- /dev/null
+++ b/src/adm_render_room/cuda/backend.cpp
@@ -0,0 +1,71 @@
+// The validated processing graph is shared with the research adapter. This
+// build selects resident prepared resources and exposes no fixture/file API.
+#define ROOM_GPU_RESIDENT 1
+#include "../../../scripts/research/room_gpu/session_backend.cpp"
+#define ROOM_CUDA_CATCH(result)                                                                                        \
+    catch (const std::exception& e) {                                                                                  \
+        remember(e.what());                                                                                            \
+        return result;                                                                                                 \
+    }                                                                                                                  \
+    catch (...) {                                                                                                      \
+        remember("Unknown CUDA resource failure");                                                                     \
+        return result;                                                                                                 \
+    }
+
+
+extern "C" __declspec(dllexport) unsigned mradm_room_cuda_abi() noexcept {
+    return 1;
+}
+extern "C" __declspec(dllexport) void*
+mradm_room_cuda_bank_create(const RoomCudaBankDesc* desc, const char* source, size_t length) noexcept {
+    try {
+        if (!desc || !source || !length || length > 1024 * 1024)
+            throw std::runtime_error("Invalid ROOM CUDA source/descriptor");
+        runtime(cudaSetDevice(0));
+        runtime(cudaFree(nullptr));
+        return new ResidentHandle(std::make_shared<ResidentBank>(*desc, source, length));
+    }
+    ROOM_CUDA_CATCH(nullptr)
+}
+extern "C" __declspec(dllexport) int
+mradm_room_cuda_bank_upload(void* bank, unsigned table, size_t offset, const float* data, size_t count) noexcept {
+    try {
+        if (!bank || !*static_cast<ResidentHandle*>(bank))
+            throw std::runtime_error("Invalid ROOM CUDA upload handle");
+        (*static_cast<ResidentHandle*>(bank))->upload(table, offset, data, count);
+        return 0;
+    }
+    ROOM_CUDA_CATCH(1)
+}
+extern "C" __declspec(dllexport) int mradm_room_cuda_bank_seal(void* bank) noexcept {
+    try {
+        if (!bank || !*static_cast<ResidentHandle*>(bank))
+            throw std::runtime_error("Invalid ROOM CUDA seal handle");
+        (*static_cast<ResidentHandle*>(bank))->seal();
+        return 0;
+    }
+    ROOM_CUDA_CATCH(1)
+}
+extern "C" __declspec(dllexport) void mradm_room_cuda_bank_destroy(void* bank) noexcept {
+    try {
+        cudaSetDevice(0);
+        delete static_cast<ResidentHandle*>(bank);
+    }
+    ROOM_CUDA_CATCH(void())
+}
+extern "C" __declspec(dllexport) const char* mradm_room_cuda_bank_device(void* bank) noexcept {
+    try {
+        return resident(bank)->properties.name;
+    }
+    ROOM_CUDA_CATCH(nullptr)
+}
+extern "C" __declspec(dllexport) int mradm_room_cuda_stats(RoomCudaStats* out) noexcept {
+    if (!out)
+        return 1;
+    *out = {room_cuda::banks.load(),
+            room_cuda::engines.load(),
+            room_cuda::late_engines.load(),
+            room_cuda::device_bytes.load(),
+            room_cuda::pinned_bytes.load()};
+    return 0;
+}
diff --git a/src/adm_render_room/cuda/resident_support.h b/src/adm_render_room/cuda/resident_support.h
new file mode 100644
index 0000000..f5eb182
--- /dev/null
+++ b/src/adm_render_room/cuda/resident_support.h
@@ -0,0 +1,266 @@
+#pragma once
+#include <algorithm>
+#include <array>
+#include <atomic>
+#include <chrono>
+#include <cstdint>
+#include <cstring>
+#include <cuda.h>
+#include <cuda_runtime_api.h>
+#include <cufft.h>
+#include <iostream>
+#include <memory>
+#include <nvrtc.h>
+#include <source_location>
+#include <stdexcept>
+#include <string>
+#include <string_view>
+#include <vector>
+
+using Clock = std::chrono::steady_clock;
+// CUDA resource handles become invalid after a context reset. Keep its unique
+// ID so a recreated primary context cannot make stale handles appear usable.
+struct Context {
+    CUcontext value = nullptr;
+    unsigned long long id = 0;
+    Context() {
+        if (cuCtxGetCurrent(&value) != CUDA_SUCCESS || !value || cuCtxGetId(value, &id) != CUDA_SUCCESS)
+            throw std::runtime_error("Cannot identify ROOM CUDA context");
+    }
+    bool valid() const noexcept {
+        unsigned long long current = 0;
+        return cuCtxGetId(value, &current) == CUDA_SUCCESS && current == id;
+    }
+    void require() const {
+        if (!valid())
+            throw std::runtime_error("ROOM CUDA context was lost; release and recreate all affected sessions");
+    }
+};
+struct StreamOwner {
+    Context context;
+    cudaStream_t value = nullptr;
+    ~StreamOwner() {
+        if (value && context.valid())
+            cudaStreamDestroy(value);
+    }
+};
+namespace room_cuda {
+inline std::atomic<std::uint64_t> banks{0}, engines{0}, late_engines{0}, device_bytes{0}, pinned_bytes{0};
+struct Counted {
+    std::atomic<std::uint64_t>& value;
+    explicit Counted(std::atomic<std::uint64_t>& v) : value(v) { ++value; }
+    ~Counted() { --value; }
+};
+} // namespace room_cuda
+
+inline void runtime(cudaError_t result, const std::source_location& where = std::source_location::current()) {
+    if (result != cudaSuccess)
+        throw std::runtime_error(std::string(cudaGetErrorString(result)) + " in " + where.function_name());
+}
+inline void driver(CUresult result) {
+    if (result != CUDA_SUCCESS) {
+        const char* message = nullptr;
+        cuGetErrorString(result, &message);
+        throw std::runtime_error(message ? message : "CUDA driver error");
+    }
+}
+inline void fft_check(cufftResult result) {
+    if (result != CUFFT_SUCCESS)
+        throw std::runtime_error("cuFFT error " + std::to_string(result));
+}
+template <class Work>
+void capture_graph(cudaStream_t stream, Work&& work, cudaGraph_t& graph, cudaGraphExec_t& execution) {
+    runtime(cudaStreamBeginCapture(stream, cudaStreamCaptureModeThreadLocal));
+    try {
+        work();
+        runtime(cudaStreamEndCapture(stream, &graph));
+        runtime(cudaGraphInstantiate(&execution, graph, 0));
+    } catch (...) {
+        cudaStreamCaptureStatus status = cudaStreamCaptureStatusNone;
+        if (cudaStreamIsCapturing(stream, &status) == cudaSuccess && status != cudaStreamCaptureStatusNone) {
+            cudaGraph_t aborted = nullptr;
+            cudaStreamEndCapture(stream, &aborted);
+            if (aborted)
+                cudaGraphDestroy(aborted);
+        }
+        throw;
+    }
+}
+struct Device {
+    Context context;
+    void* data = nullptr;
+    size_t bytes;
+    bool owned = true;
+    explicit Device(size_t count) : bytes(count) {
+        runtime(cudaMalloc(&data, bytes));
+        room_cuda::device_bytes += bytes;
+    }
+    Device(void* view, size_t count) : data(view), bytes(count), owned(false) {}
+    Device(const Device&) = delete;
+    Device& operator=(const Device&) = delete;
+    ~Device() {
+        if (owned && data) {
+            if (context.valid())
+                cudaFree(data);
+            room_cuda::device_bytes -= bytes;
+        }
+    }
+};
+struct Pinned {
+    Context context;
+    void* data = nullptr;
+    size_t bytes;
+    explicit Pinned(size_t count) : bytes(count) {
+        runtime(cudaMallocHost(&data, bytes));
+        room_cuda::pinned_bytes += bytes;
+    }
+    Pinned(const Pinned&) = delete;
+    Pinned& operator=(const Pinned&) = delete;
+    ~Pinned() {
+        if (data) {
+            if (context.valid())
+                cudaFreeHost(data);
+            room_cuda::pinned_bytes -= bytes;
+        }
+    }
+};
+struct Plan {
+    Context context;
+    cufftHandle value = 0;
+    Plan(int n, cufftType type, int count, cudaStream_t stream) {
+        try {
+            fft_check(cufftPlan1d(&value, n, type, count));
+            fft_check(cufftSetStream(value, stream));
+        } catch (...) {
+            if (value)
+                cufftDestroy(value);
+            throw;
+        }
+    }
+    ~Plan() {
+        if (value && context.valid())
+            cufftDestroy(value);
+    }
+    Plan(const Plan&) = delete;
+    Plan& operator=(const Plan&) = delete;
+};
+struct Config {
+    int rate = 96000, voices = 32, n = 4096, taps = 256, bucket_stride = 256, buckets = 1, rows = 0, materials = 1;
+};
+struct Module {
+    Context context;
+    CUmodule value = nullptr;
+    Module(const std::string& source, const Config& c, int targets, int major, int minor) {
+        nvrtcProgram program = nullptr;
+        auto check = [](nvrtcResult r) {
+            if (r != NVRTC_SUCCESS)
+                throw std::runtime_error(nvrtcGetErrorString(r));
+        };
+        try {
+            check(nvrtcCreateProgram(&program, source.c_str(), "room_cuda.cu", 0, nullptr, nullptr));
+            std::vector<std::string> options = {"--std=c++14",
+                                                "--fmad=true",
+                                                "--ftz=false",
+                                                "--prec-div=true",
+                                                "--prec-sqrt=true",
+                                                "--gpu-architecture=compute_" + std::to_string(major) +
+                                                    std::to_string(minor),
+                                                "-DFFT_N=" + std::to_string(c.n),
+                                                "-DVOICES=" + std::to_string(c.voices),
+                                                "-DTAPS=" + std::to_string(c.taps),
+                                                "-DBUCKETS=" + std::to_string(c.buckets),
+                                                "-DBUCKET_STRIDE=" + std::to_string(c.bucket_stride),
+                                                "-DPARTS=" + std::to_string((c.taps + 255) / 256),
+                                                "-DTARGETS=" + std::to_string(targets)};
+            std::vector<const char*> pointers;
+            for (const auto& option : options)
+                pointers.push_back(option.c_str());
+            const auto compiled = nvrtcCompileProgram(program, static_cast<int>(pointers.size()), pointers.data());
+            if (compiled != NVRTC_SUCCESS) {
+                size_t bytes = 0;
+                check(nvrtcGetProgramLogSize(program, &bytes));
+                std::vector<char> log(bytes + 1);
+                check(nvrtcGetProgramLog(program, log.data()));
+                throw std::runtime_error(log.data());
+            }
+            size_t bytes = 0;
+            check(nvrtcGetPTXSize(program, &bytes));
+            std::vector<char> ptx(bytes);
+            check(nvrtcGetPTX(program, ptx.data()));
+            check(nvrtcDestroyProgram(&program));
+            driver(cuModuleLoadData(&value, ptx.data()));
+        } catch (...) {
+            if (program)
+                nvrtcDestroyProgram(&program);
+            if (value)
+                cuModuleUnload(value);
+            throw;
+        }
+    }
+    ~Module() {
+        if (value && context.valid())
+            cuModuleUnload(value);
+    }
+    CUfunction function(const char* name) const {
+        CUfunction result;
+        driver(cuModuleGetFunction(&result, value, name));
+        return result;
+    }
+    Module(const Module&) = delete;
+    Module& operator=(const Module&) = delete;
+};
+
+// This descriptor is private to the optional native plugin, not adm/c_api.h.
+struct RoomCudaBankDesc {
+    std::uint32_t abi, size, rate, fft, rows;
+};
+struct RoomCudaStats {
+    std::uint64_t banks, engines, late_engines, device_bytes, pinned_bytes;
+};
+struct ResidentBank {
+    Context context;
+    room_cuda::Counted active{room_cuda::banks};
+    Config config;
+    std::string source;
+    Device bank, fractional, phases;
+    std::array<size_t, 3> written{};
+    bool sealed = false;
+    cudaDeviceProp properties{};
+    static Config validate(const RoomCudaBankDesc& desc) {
+        if (desc.abi != 1 || desc.size != sizeof(RoomCudaBankDesc) || desc.rate != 96000 || desc.fft != 4096 ||
+            !desc.rows || desc.rows > 65536)
+            throw std::runtime_error("Unsupported resident ROOM CUDA resource shape");
+        Config c;
+        c.rows = static_cast<int>(desc.rows);
+        return c;
+    }
+    ResidentBank(const RoomCudaBankDesc& desc, const char* text, size_t length)
+        : config(validate(desc)), source(text, length), bank(size_t(desc.rows) * (desc.fft / 2 + 1) * 8),
+          fractional(size_t(1025) * (desc.fft / 2 + 1) * 8), phases(size_t(desc.fft) * 8) {
+        runtime(cudaGetDeviceProperties(&properties, 0));
+    }
+    void upload(unsigned table, size_t offset, const float* data, size_t count) {
+        Device* arrays[] = {&bank, &fractional, &phases};
+        if (sealed || table >= 3 || !data || !count || offset != written[table] || offset > arrays[table]->bytes / 4 ||
+            count > arrays[table]->bytes / 4 - offset)
+            throw std::runtime_error("Invalid resident ROOM CUDA upload window");
+        runtime(cudaSetDevice(0));
+        runtime(cudaMemcpy(static_cast<float*>(arrays[table]->data) + offset, data, count * 4, cudaMemcpyHostToDevice));
+        written[table] += count;
+    }
+    void seal() {
+        if (sealed || written != std::array<size_t, 3>{bank.bytes / 4, fractional.bytes / 4, phases.bytes / 4})
+            throw std::runtime_error("Incomplete resident ROOM CUDA upload");
+        sealed = true;
+    }
+};
+using ResidentHandle = std::shared_ptr<ResidentBank>;
+inline ResidentHandle resident(void* handle) {
+    if (!handle || !*static_cast<ResidentHandle*>(handle))
+        throw std::runtime_error("Invalid ROOM CUDA bank handle");
+    auto value = *static_cast<ResidentHandle*>(handle);
+    value->context.require();
+    if (!value->sealed)
+        throw std::runtime_error("ROOM CUDA bank is not sealed");
+    return value;
+}
diff --git a/tests/manual/room_cuda_integration.py b/tests/manual/room_cuda_integration.py
new file mode 100644
index 0000000..31e80cd
--- /dev/null
+++ b/tests/manual/room_cuda_integration.py
@@ -0,0 +1,209 @@
+#!/usr/bin/env python3
+"""Opt-in Windows ROOM CUDA public-API lifecycle/numerical checks with explicit resources."""
+import argparse
+import array
+import concurrent.futures
+import ctypes as C
+import importlib.util
+import json
+import math
+import os
+from pathlib import Path
+import subprocess
+import sys
+import threading
+
+ROOT = Path(__file__).resolve().parents[2]
+spec = importlib.util.spec_from_file_location('room96', ROOT / 'tests/unit/room_96k_test.py')
+room96 = importlib.util.module_from_spec(spec)
+spec.loader.exec_module(room96)
+
+
+class Stats(C.Structure):
+    _fields_ = [(name, C.c_uint64) for name in ['banks', 'engines', 'late_engines', 'device_bytes', 'pinned_bytes']]
+
+
+class Diagnostic(room96.Sized):
+    _fields_ = [('struct_size', room96.U32), ('level', room96.I32), ('code', room96.I32),
+                ('reserved', room96.U32), ('epoch', room96.U64), ('generation', room96.U64),
+                ('element', room96.U64), ('fields', room96.U64), ('message', C.c_char_p)]
+
+
+def child(args):
+    api = room96.Api(args.library)
+    handle = room96.PTR()
+    api.ok(api.lib.adm_room_load(api.context, str(args.room).encode(), C.byref(handle)))
+    room = room96.Room(handle=handle, hrir=str(args.hrir).encode(), metres=1.5)
+    report = room96.PTR()
+    quality = 0 if args.case == 'exact' else 1
+    code = api.lib.adm_room_inspect_with_quality(api.context, C.byref(room), quality, C.byref(report))
+    if args.case in ('bad-request', 'missing'):
+        assert code != 0 and not report.value
+        error = api.lib.adm_context_last_error_message(api.context).decode()
+        api.lib.adm_room_destroy(handle)
+        api.lib.adm_destroy_context(api.context)
+        return {'case': args.case, 'error_code': code, 'message': error, 'passed': True}
+    api.ok(code)
+    info = json.loads(C.string_at(report).decode())
+    api.lib.adm_free_string(report)
+    api.lib.adm_room_destroy(handle)
+    expected_cuda = args.case in ('cuda', 'concurrent', 'device-reset')
+    assert (info.get('execution_backend') == 'cuda') == expected_cuda
+    samples = [(i % 179) * .00001 - .00089 for i in range(3333)]
+    if not expected_cuda:
+        result = api.scene(args.room, args.hrir, samples, [512, 137, 375], quality=quality, epoch_twice=True)
+        C.windll.kernel32.GetModuleHandleW.restype = C.c_void_p
+        assert not C.windll.kernel32.GetModuleHandleW('mradm_room_cuda.dll')
+        (args.output / (args.case + '.f32')).write_bytes(result)
+        api.lib.adm_destroy_context(api.context)
+        return {'case': args.case, 'frames': len(result) // 8, 'gpu_loaded': False, 'passed': True}
+
+    plugin = C.CDLL(str(args.plugin))
+    plugin.mradm_room_cuda_stats.argtypes = [C.POINTER(Stats)]
+    plugin.mradm_room_cuda_stats.restype = C.c_int
+
+    def snapshot():
+        value = Stats()
+        assert plugin.mradm_room_cuda_stats(C.byref(value)) == 0
+        return {name: getattr(value, name) for name, _ in Stats._fields_}
+
+    def cleared():
+        value = snapshot()
+        assert not any(value.values()), value
+        return value
+
+    observed = []
+    if args.case == 'device-reset':
+        # cudaDeviceReset affects this fresh subprocess's primary context, not
+        # other applications or the physical device/driver.
+        runtime = C.CDLL(str(next(args.plugin.parent.glob('cudart64*.dll'))))
+        runtime.cudaDeviceReset.restype = C.c_int
+        original = api.lib.adm_create_scene_stream_with_room_quality
+        original_pull = api.lib.adm_scene_stream_pull
+        api.lib.adm_scene_stream_last_error_message.argtypes = [room96.PTR]
+        api.lib.adm_scene_stream_last_error_message.restype = C.c_char_p
+        api.lib.adm_scene_stream_log_count.argtypes = [room96.PTR]
+        api.lib.adm_scene_stream_log_count.restype = room96.U32
+        api.lib.adm_scene_stream_log_entry.argtypes = [room96.PTR, room96.U32, C.POINTER(Diagnostic)]
+        api.lib.adm_scene_stream_log_entry.restype = C.c_int
+        failures = []
+        def checked_pull(stream, pcm, count, result):
+            code = original_pull(stream, pcm, count, result)
+            if C.cast(result, C.POINTER(room96.Pull)).contents.flags & 8:
+                for index in range(api.lib.adm_scene_stream_log_count(stream)):
+                    diagnostic = Diagnostic()
+                    assert api.lib.adm_scene_stream_log_entry(stream, index, C.byref(diagnostic))
+                    if diagnostic.level == 3:
+                        failures.append(diagnostic.message.decode())
+            return code
+        def reset_after_create(*values):
+            code = original(*values)
+            if code == 0:
+                observed.append(snapshot())
+                assert runtime.cudaDeviceReset() == 0
+            return code
+        api.lib.adm_create_scene_stream_with_room_quality = reset_after_create
+        api.lib.adm_scene_stream_pull = checked_pull
+        try:
+            api.scene(args.room, args.hrir, samples, [512], quality=1)
+            raise RuntimeError('GPU context reset was not reported')
+        except AssertionError as error:
+            message = failures[-1] if failures else str(error)
+            assert 'ROOM CUDA' in message, message
+        finally:
+            api.lib.adm_create_scene_stream_with_room_quality = original
+            api.lib.adm_scene_stream_pull = original_pull
+        cleared()
+        recovered = api.scene(args.room, args.hrir, samples, [512], quality=1)
+        assert recovered == (args.output / 'cuda.f32').read_bytes()
+        api.lib.adm_destroy_context(api.context)
+        return {'case': args.case, 'error': message, 'recreated': True,
+                'active_resources': observed, 'after_release': cleared(), 'passed': True}
+
+    if args.case == 'cuda':
+        original = api.ok
+        def checked(code):
+            original(code)
+            value = snapshot()
+            if value['engines'] and not observed:
+                observed.append(value)
+        api.ok = checked
+        results = []
+        for packets in [[512], [137, 375, 1, 511], [512]]:
+            results.append(api.scene(args.room, args.hrir, samples, packets, quality=1, epoch_twice=True))
+            cleared()
+        assert observed and all(v == results[0] for v in results)
+        (args.output / 'cuda.f32').write_bytes(results[0])
+        api.lib.adm_destroy_context(api.context)
+        return {'case': args.case, 'cycles': 3, 'epochs_per_cycle': 2, 'frames': len(results[0]) // 8,
+                'active_resources': observed, 'after_release': cleared(), 'passed': True}
+
+    barrier = threading.Barrier(2)
+    def concurrent_scene(_):
+        client = room96.Api(args.library)
+        original = client.lib.adm_create_scene_stream_with_room_quality
+        def created(*values):
+            code = original(*values)
+            if code == 0:
+                barrier.wait(timeout=90)
+                observed.append(snapshot())
+            return code
+        client.lib.adm_create_scene_stream_with_room_quality = created
+        try:
+            return client.scene(args.room, args.hrir, samples, [512, 137, 375], quality=1)
+        finally:
+            client.lib.adm_destroy_context(client.context)
+    with concurrent.futures.ThreadPoolExecutor(max_workers=2) as executor:
+        results = list(executor.map(concurrent_scene, range(2)))
+    assert len(results) == 2 and results[0] == results[1] and observed
+    assert max(v['banks'] for v in observed) == 1, observed
+    api.lib.adm_destroy_context(api.context)
+    return {'case': args.case, 'active_resources': observed, 'after_release': cleared(), 'passed': True}
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    for name in ['library', 'plugin', 'room', 'hrir', 'output']:
+        parser.add_argument('--' + name, type=Path, required=True)
+    parser.add_argument('--case', choices=['cpu', 'cuda', 'exact', 'bad-request', 'missing', 'concurrent', 'device-reset'])
+    args = parser.parse_args()
+    assert os.name == 'nt'
+    if args.case:
+        result = child(args)
+        print(json.dumps(result), flush=True)
+        return
+    args.output.mkdir(parents=True, exist_ok=False)
+    report = {'cases': []}
+    for name, value in [('cpu', '0'), ('exact', 'invalid'), ('cuda', '1'), ('concurrent', '1'),
+                        ('bad-request', 'invalid'), ('device-reset', '1')]:
+        command = [sys.executable, str(Path(__file__).resolve())]
+        for key in ['library', 'plugin', 'room', 'hrir', 'output']:
+            command += ['--' + key, str(getattr(args, key).resolve())]
+        command += ['--case', name]
+        env = dict(os.environ, MR_ADM_ROOM_CUDA=value, MR_ADM_ROOM_WORKERS='8')
+        print('lifecycle', name, flush=True)
+        result = subprocess.run(command, env=env, capture_output=True, text=True, timeout=240)
+        (args.output / (name + '.stdout')).write_text(result.stdout)
+        (args.output / (name + '.stderr')).write_text(result.stderr)
+        if result.returncode:
+            raise RuntimeError(result.stdout + result.stderr)
+        report['cases'].append(json.loads(result.stdout.strip().splitlines()[-1]))
+        (args.output / 'report.json').write_text(json.dumps(report, indent=2))
+    reference = array.array('f', (args.output / 'cpu.f32').read_bytes())
+    actual = array.array('f', (args.output / 'cuda.f32').read_bytes())
+    assert len(actual) == len(reference)
+    assert all(math.isfinite(v) for v in actual)
+    energy = sum(float(v) ** 2 for v in reference)
+    error = sum((float(a) - float(b)) ** 2 for a, b in zip(reference, actual))
+    peak = max(abs(v) for v in reference)
+    maximum = max(abs(float(a) - float(b)) for a, b in zip(reference, actual))
+    report['numerical'] = {'frames': len(actual) // 2, 'relative_l2': (error / energy) ** .5,
+                           'maximum_over_reference_peak': maximum / peak}
+    assert report['numerical']['relative_l2'] <= 2e-5 and maximum / peak <= 2e-4
+    report['passed'] = True
+    (args.output / 'report.json').write_text(json.dumps(report, indent=2))
+    print(json.dumps(report), flush=True)
+
+
+if __name__ == '__main__':
+    main()
