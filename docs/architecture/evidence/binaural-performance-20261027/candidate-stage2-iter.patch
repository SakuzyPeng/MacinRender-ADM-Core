+++ b/src/adm_engine/render_service.cpp
@@ -0,0 +1,16 @@
+
+#include <chrono>
+#include <cstdio>
+namespace {
+struct BinProbe {
+    const char* name;
+    double* sum;
+    std::chrono::steady_clock::time_point begin = std::chrono::steady_clock::now();
+    explicit BinProbe(const char* n, double* s = nullptr) : name(n), sum(s) {}
+    ~BinProbe() {
+        const auto ms = std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now() - begin).count();
+        if (sum) *sum += ms;
+        else std::fprintf(stderr, "BINPROBE %s %.9f\n", name, ms);
+    }
+};
+}
