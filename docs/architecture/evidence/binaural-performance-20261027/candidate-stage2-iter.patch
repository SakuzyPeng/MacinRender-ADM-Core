+#[cfg(windows)]
+fn bin_memory(label: &str, sources: usize) {
+    #[repr(C)] struct Counters { cb: u32, faults: u32, values: [usize; 9] }
+    #[link(name = "kernel32")]
+    unsafe extern "system" { fn K32GetProcessMemoryInfo(process: *mut core::ffi::c_void, counters: *mut Counters, size: u32) -> i32; }
+    #[link(name = "kernel32")]
+    unsafe extern "system" { fn GetCurrentProcess() -> *mut core::ffi::c_void; }
+    let mut v = Counters { cb: std::mem::size_of::<Counters>() as u32, faults: 0, values: [0; 9] };
+    unsafe { K32GetProcessMemoryInfo(GetCurrentProcess(), &mut v, std::mem::size_of::<Counters>() as u32); }
+    eprintln!("BINMEM {} sources {} peak {} working {} private {}", label, sources, v.values[0], v.values[1], v.values[8]);
+}
+#[cfg(not(windows))]
+fn bin_memory(_: &str, _: usize) {}
