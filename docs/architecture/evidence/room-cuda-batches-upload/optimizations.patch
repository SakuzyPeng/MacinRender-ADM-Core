diff --git a/scripts/research/room_gpu/session_layout.h b/scripts/research/room_gpu/session_layout.h
new file mode 100644
--- /dev/null
+++ b/scripts/research/room_gpu/session_layout.h
@@ -0,0 +1,47 @@
+#pragma once
+#include <array>
+#include <cstddef>
+#include <cstdint>
+
+namespace room_gpu_layout {
+// Keep the original capacities as a fallback. These intermediate capacities
+// avoid coupling a response-row increase to an unnecessarily large output FFT.
+inline constexpr std::array<std::array<unsigned, 3>, 16> compact_shapes{{
+    {32, 32, 64},
+    {64, 32, 128},
+    {96, 64, 256},
+    {96, 64, 352},
+    {96, 64, 384},
+    {128, 64, 352},
+    {192, 64, 352},
+    {256, 96, 352},
+    {320, 96, 352},
+    {384, 96, 352},
+    {384, 96, 384},
+    {384, 96, 448},
+    {384, 96, 512},
+    {448, 128, 448},
+    {448, 128, 512},
+    {512, 128, 448},
+}};
+
+constexpr std::uint64_t fft_work(unsigned responses, unsigned fft_rows, unsigned tasks, unsigned length) {
+    unsigned levels = 0;
+    for (unsigned n = length; n > 1; n /= 2)
+        ++levels;
+    return std::uint64_t(responses) * length * levels + std::uint64_t(fft_rows) * 512 * 9 +
+           std::uint64_t(tasks) * 2 * 512 * 9;
+}
+
+enum Field : unsigned { header, ranges, updates, tasks, groups, info, input, fields };
+struct Upload {
+    std::array<std::size_t, fields> offsets{}, capacities{};
+    std::size_t bytes = 0;
+    explicit Upload(const std::array<std::size_t, fields>& lengths) : capacities(lengths) {
+        for (unsigned i = 0; i < fields; ++i) {
+            offsets[i] = bytes;
+            bytes += (lengths[i] + 63) & ~std::size_t(63);
+        }
+    }
+};
+} // namespace room_gpu_layout
