+                for (actual, expected) in reused.states.iter().zip(&fresh.states) {
+                    assert_eq!(words(&actual.left), words(&expected.left));
+                    assert_eq!(words(&actual.right), words(&expected.right));
+                }
+            }
+        }
+    }
