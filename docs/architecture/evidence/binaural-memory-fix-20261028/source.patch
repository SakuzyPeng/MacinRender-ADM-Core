+#[test]
+fn rebuilt_banks_reuse_storage_and_match_fresh_history() {
+    let hrtf = Arc::new(binaural_hrtf::build(Dataset::kemar(), 1024, false).unwrap());
+    let plan = binaural_render::prepare(
+        &moving_scene(12000),
