+#[derive(Default)]
+struct PendingAudit {
+    pending: AtomicUsize,
+    completions: AtomicUsize,
+    dropped_pending: AtomicUsize,
+    fail_finish: AtomicBool,
+}
+struct AuditedFactory(Arc<PendingAudit>);
+struct AuditedBackend {
+    inner: Box<dyn mradm_dsp::room::gpu_experiment::Backend>,
+    audit: Arc<PendingAudit>,
+    pending: bool,
+}
+impl mradm_dsp::room::gpu_experiment::Factory for AuditedFactory {
+    fn create(
+        &self,
+        room: Arc<PreparedRoom>,
+    ) -> mradm_dsp::Result<Box<dyn mradm_dsp::room::gpu_experiment::Backend>> {
+        Ok(Box::new(AuditedBackend {
+            inner: ReferenceFactory.create(room)?,
+            audit: self.0.clone(),
+            pending: false,
+        }))
+    }
+    fn create_late(
+        &self,
+        room: Arc<PreparedRoom>,
+    ) -> mradm_dsp::Result<Option<Box<dyn mradm_dsp::room::gpu_experiment::LateBackend>>> {
+        ReferenceFactory.create_late(room)
+    }
+}
+impl mradm_dsp::room::gpu_experiment::Backend for AuditedBackend {
+    fn begin(&mut self, voices: usize) -> mradm_dsp::Result<()> {
+        assert!(
+            !self.pending,
+            "Submitted storage reused before its FIFO read"
+        );
+        self.inner.begin(voices)
+    }
+    fn voice(
+        &mut self,
+        index: usize,
+        frame: &mradm_dsp::room::gpu_experiment::Frame,
+    ) -> mradm_dsp::Result<()> {
+        assert!(!self.pending);
+        self.inner.voice(index, frame)
+    }
+    fn submit(&mut self) -> mradm_dsp::Result<()> {
+        assert!(!self.pending);
+        self.inner.submit()?;
+        self.pending = true;
+        self.audit.pending.fetch_add(1, Ordering::SeqCst);
+        Ok(())
+    }
+    fn finish(&mut self, output: &mut [f32]) -> mradm_dsp::Result<()> {
+        assert!(self.pending);
+        if self.audit.fail_finish.swap(false, Ordering::SeqCst) {
+            return Err(mradm_dsp::Error::RenderFailed(
+                "Injected deferred completion failure",
+            ));
+        }
+        self.inner.finish(output)?;
+        self.pending = false;
+        self.audit.pending.fetch_sub(1, Ordering::SeqCst);
+        self.audit.completions.fetch_add(1, Ordering::SeqCst);
+        Ok(())
+    }
+}
+impl Drop for AuditedBackend {
+    fn drop(&mut self) {
+        if self.pending {
+            self.audit.pending.fetch_sub(1, Ordering::SeqCst);
+            self.audit.dropped_pending.fetch_add(1, Ordering::SeqCst);
+        }
+    }
+}
+#[test]
+fn deferred_gpu_wait_owns_pending_work_until_consume_reset_configure_or_drop() {
+    let _lock = TEST_LOCK.lock().unwrap();
+    let base = common::fixture_at_rate(Quality::Realtime, 96000);
+    let audit = Arc::new(PendingAudit::default());
+    let deferred = Arc::new(
+        base.with_gpu_experiment(Arc::new(AuditedFactory(audit.clone())))
+            .unwrap()
+            .with_gpu_deferred_wait()
+            .unwrap(),
+    );
+    let mut session = Session::new(deferred, 1.5, true, true).unwrap();
+    let descriptions = [RoomDescription {
+        id: 1,
+        position: [0., 0.8, 0.],
+        ..Default::default()
+    }];
+    session.configure(&descriptions).unwrap();
+    let input = [0.01; 512];
+    let mut output = [0.; 1024];
+    session
+        .process(512, [Some(&input[..])].into_iter(), &[], &[], &mut output)
+        .unwrap();
+    assert_eq!(session.info().latency_frames, 256);
+    assert_eq!(audit.completions.load(Ordering::SeqCst), 1);
+    assert_eq!(audit.pending.load(Ordering::SeqCst), 1);
+    session
+        .process(0, [None].into_iter(), &[], &[], &mut [])
+        .unwrap();
+    assert_eq!(audit.pending.load(Ordering::SeqCst), 1);
+    assert!(
+        session
+            .process(1, [None].into_iter(), &[], &[], &mut [])
+            .is_err()
+    );
+    assert_eq!(audit.pending.load(Ordering::SeqCst), 1);
+    session
+        .process(1, [None].into_iter(), &[], &[], &mut output[..2])
+        .unwrap();
+    assert_eq!(audit.pending.load(Ordering::SeqCst), 0);
+    session
+        .process(255, [None].into_iter(), &[], &[], &mut output[..510])
+        .unwrap();
+    assert_eq!(audit.pending.load(Ordering::SeqCst), 1);
+    // A generation/slot mutation must consume the saved source ordering first.
+    session.clear_generation();
+    session.configure(&descriptions).unwrap();
+    assert_eq!(audit.pending.load(Ordering::SeqCst), 0);
+    session.reset(2048).unwrap();
+    session
+        .process(512, [Some(&input[..])].into_iter(), &[], &[], &mut output)
+        .unwrap();
+    assert_eq!(audit.pending.load(Ordering::SeqCst), 1);
+    audit.fail_finish.store(true, Ordering::SeqCst);
+    output.fill(f32::NAN);
+    assert!(matches!(
+        session.process(1, [None].into_iter(), &[], &[], &mut output[..2]),
+        Err(mradm_dsp::Error::RenderFailed(
+            "Injected deferred completion failure"
+        ))
+    ));
+    assert!(
+        output[..2].iter().all(|v| v.is_nan()),
+        "Failed output was published"
+    );
+    assert_eq!(audit.pending.load(Ordering::SeqCst), 1);
+    session.reset(4096).unwrap();
+    assert_eq!(audit.pending.load(Ordering::SeqCst), 0);
+    session
+        .process(512, [None].into_iter(), &[], &[], &mut output)
+        .unwrap();
+    assert!(output.iter().all(|v| *v == 0.));
+    assert_eq!(audit.pending.load(Ordering::SeqCst), 1);
+    session.end_input();
+    session
+        .process(1, [None].into_iter(), &[], &[], &mut output[..2])
+        .unwrap();
+    assert_eq!(audit.pending.load(Ordering::SeqCst), 0);
+    session.reset(4096).unwrap();
+    session
+        .process(256, [None].into_iter(), &[], &[], &mut output[..512])
+        .unwrap();
+    assert_eq!(audit.pending.load(Ordering::SeqCst), 1);
+    drop(session);
+    assert_eq!(audit.pending.load(Ordering::SeqCst), 0);
+    assert_eq!(audit.dropped_pending.load(Ordering::SeqCst), 1);
+}
